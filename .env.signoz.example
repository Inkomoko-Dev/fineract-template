# Copy to .env.signoz and fill in (do not commit .env.signoz).
# Used with: docker compose ... -f docker-compose.signoz.smtp.yml --env-file .env.signoz

SIGNOZ_EXTERNAL_URL=http://localhost:3301

# SendGrid example (verified sender required)
SIGNOZ_SMTP_FROM=alerts@yourdomain.com
SIGNOZ_SMTP_SMARTHOST=smtp.sendgrid.net:587
SIGNOZ_SMTP_USERNAME=apikey
SIGNOZ_SMTP_PASSWORD=your_sendgrid_api_key
SIGNOZ_SMTP_REQUIRE_TLS=true

# For signoz-apply-alerts.sh
# SIGNOZ_URL=http://localhost:3301
# SIGNOZ_API_EMAIL=admin@yourdomain.com
# SIGNOZ_API_PASSWORD=your_signoz_password
# SIGNOZ_ALERT_CHANNEL_IDS=uuid-from-signoz-ui-notification-channels
