{
  "alert": "Fineract High P99 Latency",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "version": "v5",
  "description": "p99 latency above 800ms on fineract-server",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "signoz_latency",
                "timeAggregation": "p99",
                "spaceAggregation": "p99"
              }
            ],
            "filters": {
              "op": "AND",
              "items": [
                {
                  "key": { "key": "service.name", "type": "tag", "isColumn": false },
                  "op": "=",
                  "value": "fineract-server"
                }
              ]
            },
            "disabled": false
          }
        }
      ]
    },
    "op": "1",
    "target": 800,
    "matchType": "4",
    "selectedQueryName": "A"
  },
  "labels": { "severity": "warning", "service": "fineract-server" },
  "annotations": {
    "summary": "High p99 latency on fineract-server",
    "description": "p99 latency exceeded 800ms for 5 minutes."
  },
  "disabled": false,
  "preferredChannels": []
}
