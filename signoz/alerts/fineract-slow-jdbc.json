{
  "alert": "Fineract Slow JDBC Query",
  "alertType": "TRACES_BASED_ALERT",
  "ruleType": "threshold_rule",
  "version": "v5",
  "description": "MariaDB spans slower than 1 second",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": 60,
            "aggregations": [{ "expression": "count()", "alias": "count" }],
            "filters": {
              "op": "AND",
              "items": [
                {
                  "key": { "key": "service.name", "type": "resource", "isColumn": false },
                  "op": "=",
                  "value": "fineract-server"
                },
                {
                  "key": { "key": "db.system", "type": "tag", "isColumn": false },
                  "op": "=",
                  "value": "mariadb"
                },
                {
                  "key": { "key": "durationNano", "type": "tag", "isColumn": true },
                  "op": ">",
                  "value": "1000000000"
                }
              ]
            },
            "disabled": false
          }
        }
      ]
    },
    "op": "1",
    "target": 3,
    "matchType": "4",
    "selectedQueryName": "A"
  },
  "labels": { "severity": "warning", "service": "fineract-server" },
  "annotations": {
    "summary": "Slow JDBC on fineract-server",
    "description": "More than 3 MariaDB spans exceeded 1s in the evaluation window."
  },
  "disabled": false,
  "preferredChannels": []
}
