{
  "alert": "Fineract Quartz Job Failure",
  "alertType": "TRACES_BASED_ALERT",
  "ruleType": "threshold_rule",
  "version": "v5",
  "description": "Quartz scheduler spans with errors",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": 60,
            "aggregations": [{ "expression": "count()", "alias": "count" }],
            "filters": {
              "op": "AND",
              "items": [
                {
                  "key": { "key": "service.name", "type": "resource", "isColumn": false },
                  "op": "=",
                  "value": "fineract-server"
                },
                {
                  "key": { "key": "hasError", "type": "tag", "isColumn": false },
                  "op": "=",
                  "value": "true"
                },
                {
                  "key": { "key": "code.namespace", "type": "tag", "isColumn": false },
                  "op": "contains",
                  "value": "quartz"
                }
              ]
            },
            "disabled": false
          }
        }
      ]
    },
    "op": "1",
    "target": 1,
    "matchType": "4",
    "selectedQueryName": "A"
  },
  "labels": { "severity": "warning", "service": "fineract-server" },
  "annotations": {
    "summary": "Quartz job failure on fineract-server",
    "description": "Error span from Quartz scheduler detected."
  },
  "disabled": false,
  "preferredChannels": []
}
