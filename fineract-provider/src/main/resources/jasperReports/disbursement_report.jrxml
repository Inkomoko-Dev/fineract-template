<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DisbursementReport"
              pageWidth="1080" pageHeight="595"
              columnWidth="1040"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail"
              uuid="b1e3c3ea-0000-4b4d-9f8e-111111111111">

    <!-- ========== STYLES ========== -->
    <style name="Title" fontName="Helvetica" fontSize="18" isBold="true"/>
    <style name="ColumnHeader" fontName="Helvetica" fontSize="8" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="Detail" fontName="Helvetica" fontSize="8"/>

    <!-- ========== PARAMETERS ========== -->
    <parameter name="REPORT_DATE" class="java.util.Date"/>
    <parameter name="START_DATE" class="java.util.Date"/>
    <parameter name="END_DATE" class="java.util.Date"/>
    <parameter name="LOCATION_ID" class="java.lang.String"/>
    <parameter name="LOCATION_NAME" class="java.lang.String"/>
    <parameter name="REQUESTED_BY" class="java.lang.String"/>
    <parameter name="INTEREST_PERCENTAGE" class="java.lang.Double" isForPrompting="false">
        <defaultValueExpression><![CDATA[new Double(10)]]></defaultValueExpression>
    </parameter>
    <parameter name="PRODUCT_IDS" class="java.lang.String" isForPrompting="false"/>
    <parameter name="PRODUCT_FILTER" class="java.lang.String" isForPrompting="false"/>
    <parameter name="OFFICER_FILTER" class="java.lang.String" isForPrompting="false"/>
    <parameter name="OFFICER_NAMES" class="java.lang.String"/>
    <parameter name="APPROVED_BY" class="java.lang.String" isForPrompting="false"/>


    <!-- ========== QUERY ========== -->
    <queryString language="SQL">
        <![CDATA[
        SELECT
            DATE(l.submittedon_date) AS request_date,
            c.display_name AS client_name,
            c.external_id AS client_uid,
            mcoi.national_identification_number AS national_id,
            mcv.code_value AS client_strata,
            dp.code_value  AS department,
            ma.city  AS location,
            p.name AS loan_product,
            l.account_no AS loan_account,
            mcoi.bank_name AS beneficiary_name,
            mcoi.bank_account_number AS beneficiary_account,
            l.approved_principal AS approved_amount,
            (COALESCE(l.approved_principal, 0) - COALESCE(l.net_disbursal_amount, 0)) AS insurance_amount,
            l.approved_principal AS total_loan_amount,
            l.net_disbursal_amount AS net_disbursal_amount,
            l.term_frequency AS tenure,
            CONCAT(g.firstname, ' ', g.lastname) AS guarantor_name,
            g.id AS guarantor_id,
            g.mobile_number AS guarantor_phone,
            col_type.code_value  AS collateral_type,
            col.value AS collateral_coverage,
            col.value AS omv,
            NULL AS fsv,
            NULL AS partner_flag,
            u.firstname AS approved_by,
            DATE(l.approvedon_date) AS approved_date,
            mpt.value AS payment_method,
            $P{REQUESTED_BY} AS requested_by,
            c.mobile_no as phone_number,
            (
                SELECT GROUP_CONCAT(DISTINCT cv.code_value SEPARATOR '; ')
                FROM m_loan_collateral lc
                LEFT JOIN m_code_value cv ON lc.type_cv_id = cv.id
                WHERE lc.loan_id = l.id
            ) AS collateral_type,
               (
                CASE
                    WHEN c.legal_form_enum = 1 THEN 'Individual'
                    WHEN c.legal_form_enum = 2 THEN 'Entity'
                    ELSE 'N/A'
                END
            ) AS business_type,
            (
            SELECT GROUP_CONCAT(DISTINCT
                CASE
                    WHEN g2.type_enum = 1 THEN 'Personal'
                    WHEN g2.type_enum = 2 THEN 'Salary'
                    ELSE cv.code_value  -- fallback if type stored in code value
                END
                SEPARATOR '; '
            )
            FROM m_guarantor g2
            LEFT JOIN m_code_value cv ON g2.client_reln_cv_id = cv.id
            WHERE g2.loan_id = l.id
        ) AS guarantor_type
        FROM m_loan l
        LEFT JOIN m_code_value dp on l.department_cv_id = dp.id
        LEFT JOIN  m_client c ON c.id = l.client_id
        LEFT JOIN m_client_other_info mcoi ON mcoi.client_id = c.id
        LEFT JOIN m_client_address mca ON mca.client_id = c.id
        LEFT JOIN m_address ma ON ma.id = mca.address_id
        LEFT JOIN m_code_value mcv ON mcoi.strata_cv_id = mcv.id
        LEFT JOIN m_product_loan p ON p.id = l.product_id
        LEFT JOIN m_guarantor g ON g.loan_id = l.id
        LEFT JOIN m_loan_collateral col ON col.loan_id = l.id
        LEFT JOIN  m_code_value col_type   on col.type_cv_id = col_type.id
        LEFT JOIN m_appuser u ON u.id = l.approvedon_userid
        LEFT JOIN m_loan_transaction lt on lt.loan_id = l.id
        LEFT JOIN m_payment_detail mpd on mpd.id=lt.payment_detail_id
        LEFT JOIN m_payment_type mpt on mpt.id=mpd.payment_type_id
        WHERE l.loan_status_id = 200
          AND l.disbursedon_date IS NULL
          AND ($P{PRODUCT_IDS} IS NULL OR $P{PRODUCT_IDS} = '' OR l.product_id IN ($P!{PRODUCT_IDS}))
          AND ($P{START_DATE} IS NULL OR DATE(l.submittedon_date) >= $P{START_DATE})
          AND ($P{END_DATE} IS NULL OR DATE(l.submittedon_date) <= $P{END_DATE})
          AND ($P{LOCATION_ID} IS NULL OR c.office_id = $P{LOCATION_ID} OR c.office_id IS NULL)
          AND ($P{OFFICER_FILTER} IS NULL OR $P{OFFICER_FILTER} = '' OR l.loan_officer_id IN ($P!{OFFICER_FILTER}))
        ORDER BY l.submittedon_date DESC;

        ]]>
    </queryString>

    <!-- ========== FIELDS ========== -->
    <field name="request_date" class="java.sql.Date"/>
    <field name="client_name"/>
    <field name="client_uid"/>
    <field name="national_id"/>
    <field name="phone_number"/>
    <field name="business_type"/>
    <field name="client_strata"/>
    <field name="department"/>
    <field name="location"/>
    <field name="loan_product"/>
    <field name="loan_account"/>
    <field name="beneficiary_name"/>
    <field name="beneficiary_account"/>
    <field name="approved_amount" class="java.math.BigDecimal"/>
    <field name="insurance_amount" class="java.math.BigDecimal"/>
    <field name="net_disbursal_amount" class="java.math.BigDecimal"/>
    <field name="total_loan_amount" class="java.math.BigDecimal"/>
    <field name="tenure"/>
    <field name="guarantor_name"/>
    <field name="guarantor_id"/>
    <field name="guarantor_phone"/>
    <field name="guarantor_type"/>
    <field name="collateral_type"/>
    <field name="collateral_coverage"/>
    <field name="omv" class="java.math.BigDecimal"/>
    <field name="fsv" class="java.math.BigDecimal"/>
    <field name="partner_flag"/>
    <field name="approved_by"/>
    <field name="approved_date" class="java.sql.Date"/>
    <field name="payment_method"/>
    <field name="requested_by"/>


    <!-- ========== VARIABLES ========== -->
    <variable name="disbursement_amount" class="java.math.BigDecimal">
        <variableExpression><![CDATA[$F{net_disbursal_amount}]]></variableExpression>
    </variable>

    <variable name="SUM_APPROVED" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{approved_amount}]]></variableExpression>
    </variable>

    <variable name="FINAL_TOTAL" class="java.math.BigDecimal">
        <variableExpression><![CDATA[
        ($V{SUM_APPROVED} == null ? new java.math.BigDecimal(0) : $V{SUM_APPROVED})
            .multiply(
                new java.math.BigDecimal(
                    1.0 + ($P{INTEREST_PERCENTAGE} == null
                           ? 0.0
                           : $P{INTEREST_PERCENTAGE}.doubleValue() / 100.0)
                )
            )
        ]]></variableExpression>
    </variable>

    <variable name="FINAL_TOTAL_WORDS">
        <variableExpression><![CDATA[
        $V{FINAL_TOTAL} == null ? "" :
            org.apache.fineract.infrastructure.dataqueries.service
                .NumberToWordsConverter.convert($V{FINAL_TOTAL}.doubleValue())
        ]]></variableExpression>
    </variable>

    <!-- ========== TITLE BAND ========== -->
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="1040" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Disbursement Report"
                    + ($P{LOCATION_NAME} != null && !$P{LOCATION_NAME}.isEmpty()
                        ? " (" + $P{LOCATION_NAME} + ")" : "")
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="520" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Report Date: " + new java.text.SimpleDateFormat("yyyy-MM-dd")
                        .format($P{REPORT_DATE} == null ? new java.util.Date() : $P{REPORT_DATE})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="520" y="34" width="520" height="14"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Requested by: " + ($P{REQUESTED_BY} == null ? "" : $P{REQUESTED_BY})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="50" width="520" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Date Range: "
                    + ($P{START_DATE} == null ? "-"
                        : new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{START_DATE}))
                    + " to "
                    + ($P{END_DATE} == null ? "-"
                        : new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{END_DATE}))
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="520" y="50" width="520" height="14"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Location: " + ($P{LOCATION_NAME} == null ? "All" : $P{LOCATION_NAME})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="70" width="1040" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Product Filter: "
                    + ($P{PRODUCT_FILTER} == null || $P{PRODUCT_FILTER}.trim().isEmpty()
                        ? "All" : $P{PRODUCT_FILTER})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="85" width="1040" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
        "Investment Officers: " + $P{OFFICER_NAMES}
    ]]></textFieldExpression>
            </textField>
        </band>
    </title>

