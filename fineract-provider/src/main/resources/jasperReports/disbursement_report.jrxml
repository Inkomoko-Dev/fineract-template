            <!-- 5. National ID  x=300  w=80 -->
            <textField isBlankWhenNull="true">
                <reportElement x="300" y="0" width="80" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{national_id}]]></textFieldExpression>
            </textField>

            <!-- 6. Phone  x=380  w=90 -->
            <textField isBlankWhenNull="true">
                <reportElement x="380" y="0" width="90" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{phone_number}]]></textFieldExpression>
            </textField>

            <!-- 7. Dept  x=470  w=60 -->
            <textField isBlankWhenNull="true">
                <reportElement x="470" y="0" width="60" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{department}]]></textFieldExpression>
            </textField>

            <!-- 8. Location  x=530  w=80 -->
            <textField isBlankWhenNull="true">
                <reportElement x="530" y="0" width="80" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{location}]]></textFieldExpression>
            </textField>

            <!-- 9. Product  x=610  w=100 -->
            <textField isBlankWhenNull="true">
                <reportElement x="610" y="0" width="100" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{loan_product}]]></textFieldExpression>
            </textField>

            <!-- 10. Loan Account + Bank sub-row  x=710  w=100 -->
            <frame>
                <reportElement x="710" y="0" width="100" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textField>
                    <reportElement x="0" y="0" width="100" height="14"/>
                    <textElement>
                        <font size="8" isBold="true"/>
                        <paragraph leftIndent="2" rightIndent="2" spacingBefore="1"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{loan_account}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="16" width="100" height="20"/>
                    <textElement>
                        <font size="6"/>
                        <paragraph leftIndent="2" rightIndent="2"/>
                    </textElement>
                    <textFieldExpression><![CDATA[
                        "Bank: " + ($F{beneficiary_name} == null ? "" : $F{beneficiary_name})
                        + " | Acc: " + ($F{beneficiary_account} == null ? "" : $F{beneficiary_account})
                    ]]></textFieldExpression>
                </textField>
            </frame>

            <!-- 11. Tenure  x=810  w=50 -->
            <textField isBlankWhenNull="true">
                <reportElement x="810" y="0" width="50" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tenure}]]></textFieldExpression>
            </textField>

            <!-- 12. Approved amount  x=860  w=80 -->
            <textField pattern="#,##0.00">
                <reportElement x="860" y="0" width="80" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{approved_amount}]]></textFieldExpression>
            </textField>

            <!-- 13. Approved Date  x=940  w=80 -->
            <textField pattern="yyyy-MM-dd" isBlankWhenNull="true">
                <reportElement x="940" y="0" width="80" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{approved_date}]]></textFieldExpression>
            </textField>

            <!-- 14. Approved By  x=1020  w=120 -->
            <textField isBlankWhenNull="true">
                <reportElement x="1020" y="0" width="120" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{approved_by}]]></textFieldExpression>
            </textField>

            <!-- 15. Guarantor Type  x=1140  w=90 -->
            <textField isBlankWhenNull="true">
                <reportElement x="1140" y="0" width="90" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{guarantor_type}]]></textFieldExpression>
            </textField>

            <!-- 16. Guarantor Info  x=1230  w=150 -->
            <textField isBlankWhenNull="true">
                <reportElement x="1230" y="0" width="150" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    ($F{guarantor_name} == null ? "" : $F{guarantor_name})
                    + ($F{guarantor_id} == null ? "" : "\nID: " + $F{guarantor_id})
                    + ($F{guarantor_phone} == null ? "" : "\nTel: " + $F{guarantor_phone})
                ]]></textFieldExpression>
            </textField>

            <!-- 17. Collateral Type  x=1380  w=100 -->
            <textField isBlankWhenNull="true">
                <reportElement x="1380" y="0" width="100" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{collateral_type}]]></textFieldExpression>
            </textField>

            <!-- 18. Collateral Info  x=1480  w=150 -->
            <textField isBlankWhenNull="true">
                <reportElement x="1480" y="0" width="150" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    ($F{collateral_coverage} == null ? "" : "Coverage: " + new java.text.DecimalFormat("#,##0.00").format($F{collateral_coverage}))
                    + ($F{omv} == null ? "" : "\nOMV: " + new java.text.DecimalFormat("#,##0.00").format($F{omv}))
                    + ($F{fsv} == null ? "" : "\nFSV: " + new java.text.DecimalFormat("#,##0.00").format($F{fsv}))
                ]]></textFieldExpression>
            </textField>

            <!-- 19. Insurance  x=1630  w=50 -->
            <textField pattern="#,##0.00">
                <reportElement x="1630" y="0" width="50" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{insurance_amount}]]></textFieldExpression>
            </textField>

            <!-- 20. Disbursement  x=1680  w=60 -->
            <textField pattern="#,##0.00">
                <reportElement x="1680" y="0" width="60" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{net_disbursal_amount}]]></textFieldExpression>
            </textField>



        </band>
    </detail>


    <!-- ========== SUMMARY ========== -->
    <summary>
        <band height="170">

            <staticText>
                <reportElement x="0" y="15" width="220" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total Approved Amount:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="230" y="15" width="150" height="16"/>
                <textElement/>
                <textFieldExpression><![CDATA[$V{SUM_APPROVED}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="44" width="220" height="14"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Interest Percentage (%):]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="44" width="80" height="14"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{INTEREST_PERCENTAGE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="68" width="220" height="14"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Final Total (with Interest):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="230" y="68" width="150" height="14"/>
                <textElement/>
                <textFieldExpression><![CDATA[$V{FINAL_TOTAL}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="92" width="220" height="14"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Final Total (in Words):]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="108" width="1040" height="16"/>
                <textElement/>
                <textFieldExpression><![CDATA[$V{FINAL_TOTAL_WORDS}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="720" y="160" width="320" height="1"/>
            </line>

            <textField>
                <reportElement x="0" y="140" width="520" height="14"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    "Generated by: "
                    + ($P{REQUESTED_BY} == null ? "" : $P{REQUESTED_BY})
                    + " on "
                    + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm")
                        .format($P{REPORT_DATE} == null ? new java.util.Date() : $P{REPORT_DATE})
                ]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
