            <!-- 10. Loan Account + Bank sub-row  x=495  w=85 -->
            <frame>
                <reportElement x="495" y="0" width="85" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textField>
                    <reportElement x="0" y="0" width="85" height="14"/>
                    <textElement>
                        <font size="8" isBold="true"/>
                        <paragraph leftIndent="2" rightIndent="2" spacingBefore="1"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{loan_account}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="16" width="85" height="20"/>
                    <textElement>
                        <font size="6"/>
                        <paragraph leftIndent="2" rightIndent="2"/>
                    </textElement>
                    <textFieldExpression><![CDATA[
                        "Bank: " + ($F{beneficiary_name} == null ? "" : $F{beneficiary_name})
                        + " | Acc: " + ($F{beneficiary_account} == null ? "" : $F{beneficiary_account})
                    ]]></textFieldExpression>
                </textField>
            </frame>

            <!-- 11. Tenure  x=580  w=40 -->
            <textField isBlankWhenNull="true">
                <reportElement x="580" y="0" width="40" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tenure}]]></textFieldExpression>
            </textField>

            <!-- 12. Approved amount  x=620  w=65 -->
            <textField pattern="#,##0.00">
                <reportElement x="620" y="0" width="65" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{approved_amount}]]></textFieldExpression>
            </textField>

            <!-- 13. Approval Info (date / by / method)  x=685  w=80 -->
            <frame>
                <reportElement x="685" y="0" width="80" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textField pattern="yyyy-MM-dd" isBlankWhenNull="true">
                    <reportElement x="0" y="0" width="80" height="12"/>
                    <textElement>
                        <font size="7" isBold="true"/>
                        <paragraph leftIndent="2" rightIndent="2"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Date: " + $F{approved_date}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="12" width="80" height="12"/>
                    <textElement>
                        <font size="7"/>
                        <paragraph leftIndent="2" rightIndent="2"/>
                    </textElement>
                    <textFieldExpression><![CDATA[
                        "By: " + ($F{approved_by} == null ? "" : $F{approved_by})
                    ]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="24" width="80" height="12"/>
                    <textElement>
                        <font size="6"/>
                        <paragraph leftIndent="2" rightIndent="2"/>
                    </textElement>
                    <textFieldExpression><![CDATA[
                        "Method: " + ($F{payment_method} == null ? "--" : $F{payment_method})
                    ]]></textFieldExpression>
                </textField>
            </frame>

            <!-- 14. Guarantor: name + phone + type  x=765  w=90 -->
            <frame>
                <reportElement x="765" y="0" width="90" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <!-- Guarantor name -->
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="0" width="90" height="13"/>
                    <textElement>
                        <font size="8" isBold="true"/>
                        <paragraph leftIndent="2" rightIndent="2" spacingBefore="1"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{guarantor_name}]]></textFieldExpression>
                </textField>
                <!-- Guarantor type -->
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="24" width="90" height="12"/>
                    <textElement>
                        <font size="6"/>
                        <paragraph leftIndent="2" rightIndent="2"/>
                    </textElement>
                    <textFieldExpression><![CDATA[
                        ($F{guarantor_type} == null ? " " : $F{guarantor_type})
                    ]]></textFieldExpression>
                </textField>
            </frame>

            <!-- 15. Collateral  x=855  w=60   -->
            <textField isBlankWhenNull="true">
                <reportElement x="855" y="0" width="60" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[
              ($F{collateral_type} == null ? " " : $F{collateral_type})]]></textFieldExpression>
            </textField>

            <!-- 16. Insurance  x=915  w=55 -->
            <textField pattern="#,##0.00">
                <reportElement x="915" y="0" width="55" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{insurance_amount}]]></textFieldExpression>
            </textField>

            <!-- 17. Disbursement  x=970  w=65 -->
            <textField pattern="#,##0.00">
                <reportElement x="970" y="0" width="65" height="36"/>
                <box>
                    <pen lineWidth="0.25"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                    <paragraph leftIndent="2" rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{disbursement_amount}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ========== SUMMARY ========== -->
    <summary>
        <band height="170">

            <staticText>
                <reportElement x="0" y="15" width="220" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total Approved Amount:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="230" y="15" width="150" height="16"/>
                <textElement/>
                <textFieldExpression><![CDATA[$V{SUM_APPROVED}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="44" width="220" height="14"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Interest Percentage (%):]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="44" width="80" height="14"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{INTEREST_PERCENTAGE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="68" width="220" height="14"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Final Total (with Interest):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="230" y="68" width="150" height="14"/>
                <textElement/>
                <textFieldExpression><![CDATA[$V{FINAL_TOTAL}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="92" width="220" height="14"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Final Total (in Words):]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="108" width="1040" height="16"/>
                <textElement/>
                <textFieldExpression><![CDATA[$V{FINAL_TOTAL_WORDS}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="720" y="160" width="320" height="1"/>
            </line>

            <textField>
                <reportElement x="0" y="140" width="520" height="14"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    "Generated by: "
                    + ($P{REQUESTED_BY} == null ? "" : $P{REQUESTED_BY})
                    + " on "
                    + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm")
                        .format($P{REPORT_DATE} == null ? new java.util.Date() : $P{REPORT_DATE})
                ]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
