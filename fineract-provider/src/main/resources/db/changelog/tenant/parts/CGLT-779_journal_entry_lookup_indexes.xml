<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        CGLT-779: indexes used by GET /journalentries?transactionId=...&amp;transactionDetails=true.
        acc_gl_journal_entry.transaction_id had no index, so every lookup scanned the whole journal.
        The other columns are indexed by the base schema; each changeset is skipped when any index already
        covers the column (whatever its name), so databases that already have them get nothing new.
    -->

    <!-- filters GET /journalentries?transactionId=... (lookup and page count) -->
    <changeSet id="CGLT-779-index-acc_gl_journal_entry-transaction_id" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="acc_gl_journal_entry" columnNames="transaction_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_acc_gl_journal_entry_transaction_id" tableName="acc_gl_journal_entry">
            <column name="transaction_id"/>
        </createIndex>
    </changeSet>

    <!-- joins the journal entry to its loan transaction and backs ?loanId= -->
    <changeSet id="CGLT-779-index-acc_gl_journal_entry-loan_transaction_id" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="acc_gl_journal_entry" columnNames="loan_transaction_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_acc_gl_journal_entry_loan_txn" tableName="acc_gl_journal_entry">
            <column name="loan_transaction_id"/>
        </createIndex>
    </changeSet>

    <!-- joins the journal entry to its savings transaction and backs ?savingsId= -->
    <changeSet id="CGLT-779-index-acc_gl_journal_entry-savings_transaction_id" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="acc_gl_journal_entry" columnNames="savings_transaction_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_acc_gl_journal_entry_savings_txn" tableName="acc_gl_journal_entry">
            <column name="savings_transaction_id"/>
        </createIndex>
    </changeSet>

    <!-- payment details recorded directly on the journal entry -->
    <changeSet id="CGLT-779-index-acc_gl_journal_entry-payment_details_id" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="acc_gl_journal_entry" columnNames="payment_details_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_acc_gl_journal_entry_payment_details" tableName="acc_gl_journal_entry">
            <column name="payment_details_id"/>
        </createIndex>
    </changeSet>

    <!-- transaction note for loan transactions -->
    <changeSet id="CGLT-779-index-m_note-loan_transaction_id" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_note" columnNames="loan_transaction_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_m_note_loan_transaction_id" tableName="m_note">
            <column name="loan_transaction_id"/>
        </createIndex>
    </changeSet>

    <!-- transaction note for savings transactions -->
    <changeSet id="CGLT-779-index-m_note-savings_account_transaction_id" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_note" columnNames="savings_account_transaction_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_m_note_savings_account_transaction_id" tableName="m_note">
            <column name="savings_account_transaction_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
