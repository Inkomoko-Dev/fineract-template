<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- HELD / retry next_step text can exceed the original 150 chars when listing missing parameters. -->
    <changeSet id="CGLT-849-widen-log-next-step" author="omoi">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_credit_decision_log" columnName="next_step"/>
        </preConditions>
        <sql>
            ALTER TABLE m_credit_decision_log MODIFY next_step VARCHAR(500) NULL;
        </sql>
    </changeSet>
</databaseChangeLog>
