<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Per loan: does this application need an automated credit decision, has someone checked the details,
         and what did the decision engine reply. A loan without a row does not need one. -->

    <changeSet id="CGLT-846-create-loan-credit-decision" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_credit_decision"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_credit_decision">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="required" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="flagged_by" type="VARCHAR(100)"/>
            <column name="flagged_on" type="DATETIME"/>
            <column name="verification_status" type="VARCHAR(25)" defaultValue="PENDING_VERIFICATION">
                <constraints nullable="false"/>
            </column>
            <column name="verified_by" type="VARCHAR(100)"/>
            <column name="verified_on" type="DATETIME"/>
            <column name="verification_note" type="VARCHAR(500)"/>
            <column name="request_status" type="VARCHAR(10)" defaultValue="NOT_SENT">
                <constraints nullable="false"/>
            </column>
            <column name="profile_id" type="BIGINT"/>
            <column name="profile_name" type="VARCHAR(150)"/>
            <column name="version_no" type="INT"/>
            <column name="requested_by" type="VARCHAR(100)"/>
            <column name="requested_on" type="DATETIME"/>
            <column name="decision" type="VARCHAR(10)"/>
            <column name="score" type="DECIMAL(10,2)"/>
            <column name="reason_codes" type="VARCHAR(500)"/>
            <column name="reply_ms" type="INT"/>
            <column name="error_message" type="VARCHAR(500)"/>
            <column name="request_json" type="LONGTEXT"/>
            <column name="reply_json" type="LONGTEXT"/>
        </createTable>
        <addUniqueConstraint tableName="m_loan_credit_decision" columnNames="loan_id"
                             constraintName="uk_loan_credit_decision_loan"/>
        <addForeignKeyConstraint baseTableName="m_loan_credit_decision" baseColumnNames="loan_id"
                                 constraintName="fk_loan_credit_decision_loan"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- What was done to the decision of an application, by whom and when: flagged, verified, re-opened, and every request
         with its outcome. The row above only holds the latest state, this keeps the history. -->

    <changeSet id="CGLT-846-create-loan-credit-decision-event" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_credit_decision_event"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_credit_decision_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="actor" type="VARCHAR(100)"/>
            <column name="occurred_on" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="detail" type="VARCHAR(500)"/>
            <column name="decision" type="VARCHAR(10)"/>
            <column name="score" type="DECIMAL(10,2)"/>
            <column name="log_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="m_loan_credit_decision_event" indexName="idx_loan_credit_decision_event_loan">
            <column name="loan_id"/>
            <column name="occurred_on"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="m_loan_credit_decision_event" baseColumnNames="loan_id"
                                 constraintName="fk_loan_credit_decision_event_loan"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- The engine's directives are AUTO_APPROVE, IC_REVIEW_REQUIRED and INELIGIBLE, as in the Credit Scoring Process Flow.
         The first draft stored GO, REVIEW and NO-GO, so what was stored is renamed. The risk tier, the largest exposure the
         engine allows and the model version are kept beside the decision. -->

    <changeSet id="CGLT-846-credit-decision-process-flow-outcomes" author="omoi">
        <sql>
            ALTER TABLE m_loan_credit_decision MODIFY decision VARCHAR(20) NULL,
                ADD COLUMN risk_tier VARCHAR(30) NULL, ADD COLUMN max_exposure DECIMAL(19,6) NULL,
                ADD COLUMN model_version VARCHAR(100) NULL;
            ALTER TABLE m_loan_credit_decision_event MODIFY decision VARCHAR(20) NULL;
            ALTER TABLE m_credit_decision_log MODIFY decision VARCHAR(20) NULL,
                ADD COLUMN risk_tier VARCHAR(30) NULL, ADD COLUMN max_exposure DECIMAL(19,6) NULL,
                ADD COLUMN model_version VARCHAR(100) NULL;
            UPDATE m_loan_credit_decision SET decision = CASE decision WHEN 'GO' THEN 'AUTO_APPROVE'
                WHEN 'REVIEW' THEN 'IC_REVIEW_REQUIRED' WHEN 'NO-GO' THEN 'INELIGIBLE' ELSE decision END WHERE decision IS NOT NULL;
            UPDATE m_loan_credit_decision_event SET decision = CASE decision WHEN 'GO' THEN 'AUTO_APPROVE'
                WHEN 'REVIEW' THEN 'IC_REVIEW_REQUIRED' WHEN 'NO-GO' THEN 'INELIGIBLE' ELSE decision END WHERE decision IS NOT NULL;
            UPDATE m_credit_decision_log SET decision = CASE decision WHEN 'GO' THEN 'AUTO_APPROVE'
                WHEN 'REVIEW' THEN 'IC_REVIEW_REQUIRED' WHEN 'NO-GO' THEN 'INELIGIBLE' ELSE decision END WHERE decision IS NOT NULL;
        </sql>
    </changeSet>

    <!-- One send at a time per application, a request identifier that is kept so a retry can reuse it, and what is needed to
         retry a failed send by the clock and to alert the credit team: how many sends failed in a row, when the next
         automatic retry is due, and whether the team was told. send_started_on is the claim a running send holds. -->

    <changeSet id="CGLT-846-credit-decision-send-lock-and-retry" author="omoi">
        <sql>
            ALTER TABLE m_loan_credit_decision ADD COLUMN request_id VARCHAR(40) NULL, ADD COLUMN send_started_on DATETIME NULL,
                ADD COLUMN last_attempt_on DATETIME NULL, ADD COLUMN failure_count INT NOT NULL DEFAULT 0,
                ADD COLUMN next_retry_on DATETIME NULL, ADD COLUMN alerted_on DATETIME NULL;
            CREATE INDEX idx_loan_credit_decision_retry ON m_loan_credit_decision (request_status, next_retry_on);
            ALTER TABLE m_credit_decision_log ADD COLUMN request_id VARCHAR(40) NULL;
            CREATE INDEX idx_credit_decision_log_request ON m_credit_decision_log (request_id);
        </sql>
    </changeSet>

    <changeSet id="CGLT-846-retry-failed-credit-decisions-job" author="omoi">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM job WHERE name = 'Retry Failed Credit Decisions'
            </sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Retry Failed Credit Decisions"/>
            <column name="display_name" value="Retry Failed Credit Decisions"/>
            <column name="cron_expression" value="0 */5 * * * ?"/>
            <column name="create_time" valueDate="NOW()"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="job_key" value="Retry Failed Credit Decisions _ DEFAULT"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-846-loan-credit-decision-permissions" author="omoi">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'UPDATE_CREDITDECISIONLOAN', 'CREDITDECISIONLOAN', 'UPDATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'VERIFY_CREDITDECISIONLOAN', 'CREDITDECISIONLOAN', 'VERIFY', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'SEND_CREDITDECISIONLOAN', 'CREDITDECISIONLOAN', 'SEND', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
        </sql>
    </changeSet>

    <changeSet id="CGLT-846-grant-loan-credit-decision-to-super-user" author="omoi">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            JOIN m_permission p ON p.entity_name = 'CREDITDECISIONLOAN'
            WHERE r.name = 'Super user'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>

</databaseChangeLog>
