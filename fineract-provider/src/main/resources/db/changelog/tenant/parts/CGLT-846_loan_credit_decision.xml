<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Per loan: does this application need an automated credit decision, has someone checked the details,
         and what did the decision engine reply. A loan without a row does not need one. -->

    <changeSet id="CGLT-846-create-loan-credit-decision" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_credit_decision"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_credit_decision">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="required" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="flagged_by" type="VARCHAR(100)"/>
            <column name="flagged_on" type="DATETIME"/>
            <column name="verification_status" type="VARCHAR(25)" defaultValue="PENDING_VERIFICATION">
                <constraints nullable="false"/>
            </column>
            <column name="verified_by" type="VARCHAR(100)"/>
            <column name="verified_on" type="DATETIME"/>
            <column name="verification_note" type="VARCHAR(500)"/>
            <column name="request_status" type="VARCHAR(10)" defaultValue="NOT_SENT">
                <constraints nullable="false"/>
            </column>
            <column name="profile_id" type="BIGINT"/>
            <column name="profile_name" type="VARCHAR(150)"/>
            <column name="version_no" type="INT"/>
            <column name="requested_by" type="VARCHAR(100)"/>
            <column name="requested_on" type="DATETIME"/>
            <column name="decision" type="VARCHAR(10)"/>
            <column name="score" type="DECIMAL(10,2)"/>
            <column name="reason_codes" type="VARCHAR(500)"/>
            <column name="reply_ms" type="INT"/>
            <column name="error_message" type="VARCHAR(500)"/>
            <column name="request_json" type="LONGTEXT"/>
            <column name="reply_json" type="LONGTEXT"/>
        </createTable>
        <addUniqueConstraint tableName="m_loan_credit_decision" columnNames="loan_id"
                             constraintName="uk_loan_credit_decision_loan"/>
        <addForeignKeyConstraint baseTableName="m_loan_credit_decision" baseColumnNames="loan_id"
                                 constraintName="fk_loan_credit_decision_loan"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="CGLT-846-loan-credit-decision-permissions" author="omoi">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'UPDATE_CREDITDECISIONLOAN', 'CREDITDECISIONLOAN', 'UPDATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'VERIFY_CREDITDECISIONLOAN', 'CREDITDECISIONLOAN', 'VERIFY', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'SEND_CREDITDECISIONLOAN', 'CREDITDECISIONLOAN', 'SEND', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
        </sql>
    </changeSet>

    <changeSet id="CGLT-846-grant-loan-credit-decision-to-super-user" author="omoi">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            JOIN m_permission p ON p.entity_name = 'CREDITDECISIONLOAN'
            WHERE r.name = 'Super user'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>

</databaseChangeLog>
