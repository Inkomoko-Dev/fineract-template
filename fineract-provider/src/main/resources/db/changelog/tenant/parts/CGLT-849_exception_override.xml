<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Maker-Checker exception resolution: REEVALUATE or MANUAL_IC, pending until a different user approves or cancels. -->

    <changeSet id="CGLT-849-create-exception-override" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_credit_decision_exception_override"/>
            </not>
        </preConditions>
        <createTable tableName="m_credit_decision_exception_override">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="requested_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_on" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="decided_by" type="VARCHAR(100)"/>
            <column name="decided_on" type="DATETIME"/>
            <column name="decision_note" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="m_credit_decision_exception_override" indexName="idx_cd_exception_override_loan">
            <column name="loan_id"/>
        </createIndex>
        <createIndex tableName="m_credit_decision_exception_override" indexName="idx_cd_exception_override_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="CGLT-849-exception-override-permissions" author="omoi">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'CREATE_CREDITDECISIONEXCEPTIONOVERRIDE', 'CREDITDECISIONEXCEPTIONOVERRIDE', 'CREATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'APPROVE_CREDITDECISIONEXCEPTIONOVERRIDE', 'CREDITDECISIONEXCEPTIONOVERRIDE', 'APPROVE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            JOIN m_permission p ON p.code IN ('CREATE_CREDITDECISIONEXCEPTIONOVERRIDE', 'APPROVE_CREDITDECISIONEXCEPTIONOVERRIDE')
            WHERE r.name = 'Super user'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>

    <!-- One PENDING override per loan (NULLs allowed for closed rows). -->
    <changeSet id="CGLT-849-exception-override-pending-unique" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_credit_decision_exception_override" columnName="pending_loan_id"/>
            </not>
        </preConditions>
        <sql>
            ALTER TABLE m_credit_decision_exception_override
                ADD COLUMN pending_loan_id BIGINT
                    GENERATED ALWAYS AS (CASE WHEN status = 'PENDING' THEN loan_id ELSE NULL END) STORED;
            CREATE UNIQUE INDEX uk_cd_exception_override_pending
                ON m_credit_decision_exception_override (pending_loan_id);
        </sql>
    </changeSet>
</databaseChangeLog>
