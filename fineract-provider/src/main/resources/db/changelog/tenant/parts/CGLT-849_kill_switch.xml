<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Emergency kill switch: GLOBAL / COUNTRY (currency) / PRODUCT. When enabled, auto-approval is suppressed and
         applications enter manual IC Level 1. Precedence: GLOBAL > COUNTRY > PRODUCT > profile mode. -->

    <changeSet id="CGLT-849-create-kill-switch" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_credit_decision_kill_switch"/>
            </not>
        </preConditions>
        <createTable tableName="m_credit_decision_kill_switch">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="scope_key" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_on" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="m_credit_decision_kill_switch" columnNames="scope, scope_key"
                             constraintName="uk_credit_decision_kill_switch_scope"/>
    </changeSet>

    <changeSet id="CGLT-849-kill-switch-permissions" author="omoi">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'READ_CREDITDECISIONKILLSWITCH', 'CREDITDECISIONKILLSWITCH', 'READ', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'UPDATE_CREDITDECISIONKILLSWITCH', 'CREDITDECISIONKILLSWITCH', 'UPDATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            JOIN m_permission p ON p.code IN ('READ_CREDITDECISIONKILLSWITCH', 'UPDATE_CREDITDECISIONKILLSWITCH')
            WHERE r.name = 'Super user'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>
</databaseChangeLog>
