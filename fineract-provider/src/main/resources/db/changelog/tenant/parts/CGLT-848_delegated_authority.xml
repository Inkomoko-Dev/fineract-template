<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Where an application the engine marked IC_REVIEW_REQUIRED enters the IC levels. The first rule that fits the
         country (currency), the amount and the risk tier decides, and the levels below it are skipped. -->

    <changeSet id="CGLT-848-create-ic-delegated-authority" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_ic_delegated_authority"/>
            </not>
        </preConditions>
        <createTable tableName="m_ic_delegated_authority">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- empty means any country / any risk tier -->
            <column name="currency" type="VARCHAR(3)"/>
            <column name="risk_tier" type="VARCHAR(30)"/>
            <column name="min_amount" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <!-- empty means no upper limit -->
            <column name="max_amount" type="DECIMAL(19,6)"/>
            <column name="entry_level_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="approver_user_id" type="BIGINT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(200)"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_on" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_on" type="DATETIME"/>
        </createTable>
        <createIndex tableName="m_ic_delegated_authority" indexName="idx_ic_delegated_authority_currency">
            <column name="currency"/>
        </createIndex>
    </changeSet>

    <changeSet id="CGLT-848-delegated-authority-permissions" author="omoi">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'CREATE_ICDELEGATEDAUTHORITY', 'ICDELEGATEDAUTHORITY', 'CREATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'UPDATE_ICDELEGATEDAUTHORITY', 'ICDELEGATEDAUTHORITY', 'UPDATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('portfolio', 'DELETE_ICDELEGATEDAUTHORITY', 'ICDELEGATEDAUTHORITY', 'DELETE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
        </sql>
    </changeSet>

    <changeSet id="CGLT-848-grant-delegated-authority-to-super-user" author="omoi">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            JOIN m_permission p ON p.code IN ('CREATE_ICDELEGATEDAUTHORITY', 'UPDATE_ICDELEGATEDAUTHORITY',
                                              'DELETE_ICDELEGATEDAUTHORITY')
            WHERE r.name = 'Super user'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>
</databaseChangeLog>
