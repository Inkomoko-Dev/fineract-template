    <changeSet id="CGLT-618-9-default-country-bands" author="Felix Mutua">
        <comment>Seed default arrears bands for Kenya, Rwanda and South Sudan when those COUNTRY code values exist</comment>
        <sql>
            INSERT INTO m_loan_classification_country_config (country_cv_id, created_on_utc)
            SELECT cv.id, NOW()
            FROM m_code_value cv
            INNER JOIN m_code c ON c.id = cv.code_id AND c.code_name = 'COUNTRY'
            WHERE cv.code_value IN ('Kenya', 'Rwanda', 'South Sudan')
              AND NOT EXISTS (
                  SELECT 1 FROM m_loan_classification_country_config cfg WHERE cfg.country_cv_id = cv.id
              );
        </sql>
        <sql>
            INSERT INTO m_loan_classification_threshold (country_config_id, classification_code, min_days_in_arrears, max_days_in_arrears)
            SELECT cfg.id, bands.code, bands.min_days, bands.max_days
            FROM m_loan_classification_country_config cfg
            INNER JOIN m_code_value cv ON cv.id = cfg.country_cv_id
            INNER JOIN m_code c ON c.id = cv.code_id AND c.code_name = 'COUNTRY'
            INNER JOIN (
                SELECT 1 AS code, 0 AS min_days, 30 AS max_days
                UNION ALL SELECT 2, 31, 90
                UNION ALL SELECT 3, 91, 180
                UNION ALL SELECT 4, 181, 360
                UNION ALL SELECT 5, 361, NULL
            ) bands
            WHERE cv.code_value IN ('Kenya', 'Rwanda', 'South Sudan')
              AND NOT EXISTS (
                  SELECT 1 FROM m_loan_classification_threshold t
                  WHERE t.country_config_id = cfg.id AND t.classification_code = bands.code
              );
        </sql>
    </changeSet>

    <changeSet id="CGLT-618-10-stretchy-country-parameter" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM stretchy_parameter WHERE parameter_name = 'CountryIdSelectAll'
            </sqlCheck>
        </preConditions>
        <insert tableName="stretchy_parameter">
            <column name="parameter_name" value="CountryIdSelectAll"/>
            <column name="parameter_variable" value="countryId"/>
            <column name="parameter_label" value="Country"/>
            <column name="parameter_displayType" value="select"/>
            <column name="parameter_FormatType" value="number"/>
            <column name="parameter_default" value="-1"/>
            <column name="selectAll" value="Y"/>
            <column name="parameter_sql">
                <![CDATA[SELECT -1 AS id, 'All' AS name
UNION ALL
SELECT cv.id, cv.code_value AS name
FROM m_code_value cv
INNER JOIN m_code c ON c.id = cv.code_id AND c.code_name = 'COUNTRY'
WHERE cv.is_active = 1
ORDER BY name]]>
            </column>
        </insert>
    </changeSet>

    <changeSet id="CGLT-618-11-summary-report" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM stretchy_report WHERE report_name = 'Loan Classification Summary'
            </sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Loan Classification Summary"/>
            <column name="report_type" value="Table"/>
            <column name="report_subtype"/>
            <column name="report_category" value="Loan"/>
            <column name="report_sql">
                <![CDATA[SELECT
    COALESCE(cv.code_value, 'Unassigned') AS country,
    o.name AS office,
    lp.name AS loan_product,
    lc.classification_code AS classification,
    COALESCE(code.label, 'Invalid/Missing') AS classification_label,
    COUNT(*) AS loan_count,
    SUM(CASE WHEN lc.excluded_from_downstream = 1 THEN 1 ELSE 0 END) AS excluded_count,
    SUM(CASE WHEN lc.override_active = 1 THEN 1 ELSE 0 END) AS override_count
FROM m_loan_classification lc
INNER JOIN m_loan l ON l.id = lc.loan_id
INNER JOIN m_office o ON o.id = l.office_id
INNER JOIN m_product_loan lp ON lp.id = l.product_id
LEFT JOIN m_code_value cv ON cv.id = lc.country_cv_id
LEFT JOIN m_loan_classification_code code ON code.code = lc.classification_code
WHERE l.loan_status_id IN (300, 601)
  AND (DATE(lc.classified_on_utc) BETWEEN DATE('${startDate}') AND DATE('${endDate}'))
  AND (${officeId} = 0 OR l.office_id = ${officeId} OR o.hierarchy LIKE CONCAT((SELECT hierarchy FROM m_office WHERE id = ${officeId}), '%'))
  AND (${loanProductId} = -1 OR l.product_id = ${loanProductId})
  AND (${countryId} = -1 OR lc.country_cv_id = ${countryId})
GROUP BY country, office, loan_product, classification, classification_label
ORDER BY country, office, loan_product, classification]]>
            </column>
            <column name="description" value="Distribution of current loan classifications by country, office and product."/>
            <column name="core_report" valueBoolean="true"/>
            <column name="use_report" valueBoolean="true"/>
            <column name="self_service_user_report" valueBoolean="false"/>
        </insert>
    </changeSet>

