<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-618-1-permissions" author="Felix Mutua">
        <comment>Loan classification admin, override, and report permissions</comment>
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES
                ('organisation', 'READ_LOANCLASSIFICATIONCONFIG', 'LOANCLASSIFICATIONCONFIG', 'READ', 0),
                ('organisation', 'CREATE_LOANCLASSIFICATIONCONFIG', 'LOANCLASSIFICATIONCONFIG', 'CREATE', 1),
                ('organisation', 'UPDATE_LOANCLASSIFICATIONCONFIG', 'LOANCLASSIFICATIONCONFIG', 'UPDATE', 1),
                ('organisation', 'DELETE_LOANCLASSIFICATIONCONFIG', 'LOANCLASSIFICATIONCONFIG', 'DELETE', 1),
                ('portfolio', 'READ_LOANCLASSIFICATION', 'LOANCLASSIFICATION', 'READ', 0),
                ('portfolio', 'OVERRIDE_LOANCLASSIFICATION', 'LOANCLASSIFICATION', 'OVERRIDE', 1)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
        </sql>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT rp.role_id, p.id
            FROM m_permission p
            INNER JOIN m_role_permission rp ON rp.permission_id = (
                SELECT id FROM m_permission WHERE code = 'READ_LOAN' LIMIT 1
            )
            WHERE p.code IN ('READ_LOANCLASSIFICATION', 'READ_LOANCLASSIFICATIONCONFIG')
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission existing
                  WHERE existing.role_id = rp.role_id AND existing.permission_id = p.id
              );
        </sql>
    </changeSet>

    <changeSet id="CGLT-618-2-code-table" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_classification_code"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_classification_code">
            <column name="code" type="SMALLINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>
        <insert tableName="m_loan_classification_code">
            <column name="code" valueNumeric="1"/>
            <column name="label" value="Normal/Performing"/>
            <column name="description" value="0-30 days in arrears by default"/>
        </insert>
        <insert tableName="m_loan_classification_code">
            <column name="code" valueNumeric="2"/>
            <column name="label" value="Watch"/>
            <column name="description" value="31-90 days in arrears by default"/>
        </insert>
        <insert tableName="m_loan_classification_code">
            <column name="code" valueNumeric="3"/>
            <column name="label" value="Substandard"/>
            <column name="description" value="91-180 days in arrears by default"/>
        </insert>
        <insert tableName="m_loan_classification_code">
            <column name="code" valueNumeric="4"/>
            <column name="label" value="Doubtful"/>
            <column name="description" value="181-360 days in arrears by default"/>
        </insert>
        <insert tableName="m_loan_classification_code">
            <column name="code" valueNumeric="5"/>
            <column name="label" value="Loss"/>
            <column name="description" value="More than 360 days in arrears by default"/>
        </insert>
        <insert tableName="m_loan_classification_code">
            <column name="code" valueNumeric="6"/>
            <column name="label" value="Write-off"/>
            <column name="description" value="Assigned immediately when loan status is written-off"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-618-3-country-config" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_classification_country_config"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_classification_country_config">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country_cv_id" type="INT">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_loan_classification_country"
                             foreignKeyName="fk_loan_classification_country_cv"
                             references="m_code_value(id)"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="CGLT-618-4-thresholds" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_classification_threshold"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_classification_threshold">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country_config_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_loan_classification_threshold_config"
                             references="m_loan_classification_country_config(id)"/>
            </column>
            <column name="classification_code" type="SMALLINT">
                <constraints nullable="false"
                             foreignKeyName="fk_loan_classification_threshold_code"
                             references="m_loan_classification_code(code)"/>
            </column>
            <column name="min_days_in_arrears" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="max_days_in_arrears" type="INT"/>
        </createTable>
        <createIndex tableName="m_loan_classification_threshold" indexName="idx_loan_classification_threshold_config">
            <column name="country_config_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="CGLT-618-5-loan-record" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_classification"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_classification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_loan_classification_loan"
                             foreignKeyName="fk_loan_classification_loan"
                             references="m_loan(id)"/>
            </column>
            <column name="classification_code" type="SMALLINT"/>
            <column name="status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="days_in_arrears" type="INT"/>
            <column name="country_cv_id" type="INT"/>
            <column name="error_message" type="VARCHAR(1000)"/>
            <column name="excluded_from_downstream" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="override_active" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="override_reason" type="VARCHAR(500)"/>
            <column name="override_by" type="BIGINT"/>
            <column name="override_on_utc" type="TIMESTAMP"/>
            <column name="classified_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="classified_by" type="BIGINT"/>
        </createTable>
        <createIndex tableName="m_loan_classification" indexName="idx_loan_classification_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="m_loan_classification" indexName="idx_loan_classification_country">
            <column name="country_cv_id"/>
        </createIndex>
        <sql>
            ALTER TABLE m_loan_classification
                ADD CONSTRAINT chk_loan_classification_code
                CHECK (classification_code IS NULL OR (classification_code BETWEEN 1 AND 6));
        </sql>
    </changeSet>

