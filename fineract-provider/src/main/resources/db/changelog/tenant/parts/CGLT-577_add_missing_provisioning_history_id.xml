<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        CGLT-577_provisioning_batch_reversal_and_history.xml sorts before
        CGLT-577_provisioning_batching.xml under includeAll, so its addColumn
        changesets were MARK_RAN while the tables did not exist. Add the
        missing columns after the tables are created.
    -->

    <changeSet id="CGLT-577-add-provisioning-history-id-to-batch" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch"/>
                <not>
                    <columnExists tableName="m_provisioning_batch" columnName="provisioning_history_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="m_provisioning_batch">
            <column name="provisioning_history_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="CGLT-577-add-provisioning-batch-history-index" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="m_provisioning_batch" columnName="provisioning_history_id"/>
                <not>
                    <indexExists tableName="m_provisioning_batch" indexName="idx_provisioning_batch_history"/>
                </not>
            </and>
        </preConditions>
        <createIndex tableName="m_provisioning_batch" indexName="idx_provisioning_batch_history">
            <column name="provisioning_history_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="CGLT-577-add-is-reversal-to-batch-journal" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch_journal"/>
                <not>
                    <columnExists tableName="m_provisioning_batch_journal" columnName="is_reversal"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="m_provisioning_batch_journal">
            <column name="is_reversal" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="CGLT-577-add-reversed-journal-id-to-batch-journal" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch_journal"/>
                <not>
                    <columnExists tableName="m_provisioning_batch_journal" columnName="reversed_journal_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="m_provisioning_batch_journal">
            <column name="reversed_journal_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="CGLT-577-add-provisioning-history-id-to-batch-journal" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch_journal"/>
                <not>
                    <columnExists tableName="m_provisioning_batch_journal" columnName="provisioning_history_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="m_provisioning_batch_journal">
            <column name="provisioning_history_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="CGLT-577-add-provisioning-batch-journal-reversal-index" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="m_provisioning_batch_journal" columnName="is_reversal"/>
                <not>
                    <indexExists tableName="m_provisioning_batch_journal" indexName="idx_provisioning_batch_journal_reversal"/>
                </not>
            </and>
        </preConditions>
        <createIndex tableName="m_provisioning_batch_journal" indexName="idx_provisioning_batch_journal_reversal">
            <column name="is_reversal"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
