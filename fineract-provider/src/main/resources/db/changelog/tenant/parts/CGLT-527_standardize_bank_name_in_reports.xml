<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="Willy" id="CGLT-527_standardize_bank_name_in_reports" context="mysql">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="stretchy_report"/>
            <tableExists tableName="ref_banks"/>
        </preConditions>
        <sql><![CDATA[
            UPDATE stretchy_report
            SET report_sql = REPLACE(
                    REPLACE(
                        report_sql,
                        'coi.bank_name                                              AS `Bank Name`',
                        'COALESCE(rb.bank_name, coi.bank_name)                      AS `Bank Name`'
                    ),
                    'LEFT JOIN m_client_other_info coi
                                             ON coi.client_id = c.id',
                    'LEFT JOIN m_client_other_info coi
                                             ON coi.client_id = c.id
                                           LEFT JOIN ref_banks rb
                                             ON rb.id = coi.bank_id'
                )
            WHERE report_sql LIKE '%coi.bank_name%`Bank Name`%'
              AND report_sql NOT LIKE '%ref_banks rb%';
        ]]></sql>
    </changeSet>
</databaseChangeLog>
