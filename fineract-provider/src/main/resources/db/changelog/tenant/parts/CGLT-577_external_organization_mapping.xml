<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-577-create-external-organization-mapping" author="omoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_external_organization_mapping"/>
            </not>
        </preConditions>
        <createTable tableName="m_external_organization_mapping">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="office_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="external_system" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="external_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(10)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_external_organization_mapping"
                                 baseColumnNames="office_id"
                                 constraintName="fk_ext_org_mapping_office"
                                 referencedTableName="m_office"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="m_external_organization_mapping"
                             columnNames="office_id, external_system"
                             constraintName="uk_ext_org_mapping_office_system"/>
        <createIndex tableName="m_external_organization_mapping" indexName="idx_ext_org_mapping_system_active">
            <column name="external_system"/>
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet id="CGLT-577-enable-external-org-provision-batching-config" author="omoi">
        <validCheckSum>8:0effc0dbfbe3797f6a51dbdff3bbfdd0</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM c_configuration WHERE name = 'enable-external-organization-provision-batching'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="enable-external-organization-provision-batching"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value" value="GL"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description"
                    value="Provision journals are grouped only by m_external_organization_mapping for the system in string_value. Journal name uses the mapping organization name (for example Inkomoko Kenya Capital); reversals append reversal. Unmapped offices are not posted."/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-577-external-org-mapping-permissions" author="omoi">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('organisation', 'READ_EXTERNALORGANIZATIONMAPPING', 'EXTERNALORGANIZATIONMAPPING', 'READ', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('organisation', 'CREATE_EXTERNALORGANIZATIONMAPPING', 'EXTERNALORGANIZATIONMAPPING', 'CREATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('organisation', 'UPDATE_EXTERNALORGANIZATIONMAPPING', 'EXTERNALORGANIZATIONMAPPING', 'UPDATE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('organisation', 'DELETE_EXTERNALORGANIZATIONMAPPING', 'EXTERNALORGANIZATIONMAPPING', 'DELETE', 0)
            ON DUPLICATE KEY UPDATE entity_name = VALUES(entity_name);
        </sql>
    </changeSet>

    <changeSet id="CGLT-577-grant-external-org-mapping-to-super-user" author="omoi">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            JOIN m_permission p ON p.entity_name = 'EXTERNALORGANIZATIONMAPPING'
            WHERE r.name = 'Super user'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = r.id AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>

</databaseChangeLog>
