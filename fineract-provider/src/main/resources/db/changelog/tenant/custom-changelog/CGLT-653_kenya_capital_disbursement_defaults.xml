<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-653_add_kenya_capital_disbursement_defaults_config" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                select count(1) from c_configuration where name = 'kenya-capital-disbursement-defaults-enabled';
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="kenya-capital-disbursement-defaults-enabled"/>
            <column name="value" value="null"/>
            <column name="date_value" value="null"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Enable automatic Investment department and monthly investments budget defaults for Inkomoko Kenya Capital loan disbursements"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-653_add_kenya_capital_office_name_config" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                select count(1) from c_configuration where name = 'kenya-capital-office-name';
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="kenya-capital-office-name"/>
            <column name="string_value" value="Inkomoko Kenya Capital"/>
            <column name="value" value="null"/>
            <column name="date_value" value="null"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Office name used to identify Inkomoko Kenya Capital loans for disbursement defaults"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-653_add_kenya_capital_department_name_config" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                select count(1) from c_configuration where name = 'kenya-capital-default-department-name';
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="kenya-capital-default-department-name"/>
            <column name="string_value" value="Investment"/>
            <column name="value" value="null"/>
            <column name="date_value" value="null"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Default department label for Inkomoko Kenya Capital loan disbursements"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-653_add_investments_budget_code_name_config" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                select count(1) from c_configuration where name = 'investments-budget-code-name';
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="investments-budget-code-name"/>
            <column name="string_value" value="InvestmentsBudget"/>
            <column name="value" value="null"/>
            <column name="date_value" value="null"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Code name used to validate monthly investments budget locations for Kenya Capital disbursements"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-653_add_investments_budget_code" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                select count(1) from m_code where code_name = 'InvestmentsBudget';
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code">
            <column name="code_name" value="InvestmentsBudget"/>
            <column name="is_system_defined" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="CGLT-653_add_budget_fields_to_loan_disbursement_detail" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_loan_disbursement_detail"/>
            <not>
                <columnExists tableName="m_loan_disbursement_detail" columnName="budget_location"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan_disbursement_detail">
            <column name="budget_location" type="VARCHAR(255)"/>
            <column name="budget_review_required" type="BOOLEAN"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
