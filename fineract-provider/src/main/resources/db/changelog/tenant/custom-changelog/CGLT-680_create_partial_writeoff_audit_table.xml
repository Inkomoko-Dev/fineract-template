<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-680-3" author="inkomoko" runOnChange="true">
        <comment>Create audit table for partial write-off transactions</comment>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_partial_writeoff_audit"/>
            </not>
        </preConditions>
        <createTable tableName="m_partial_writeoff_audit">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="principal_portion" type="DECIMAL(19,6)"/>
            <column name="interest_portion" type="DECIMAL(19,6)"/>
            <column name="fee_charges_portion" type="DECIMAL(19,6)"/>
            <column name="penalty_charges_portion" type="DECIMAL(19,6)"/>
            <column name="total_amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="loan_balance_before" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="loan_balance_after" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="initiated_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="initiated_on" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="BIGINT"/>
            <column name="approved_on" type="TIMESTAMP"/>
            <column name="office_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(1000)"/>
            <column name="external_id" type="VARCHAR(100)"/>
            <column name="created_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="last_modified_by" type="BIGINT"/>
        </createTable>
        
        <addForeignKeyConstraint baseTableName="m_partial_writeoff_audit" baseColumnNames="loan_id" 
                                 constraintName="fk_partial_writeoff_audit_loan" 
                                 referencedTableName="m_loan" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_partial_writeoff_audit" baseColumnNames="loan_transaction_id" 
                                 constraintName="fk_partial_writeoff_audit_loan_transaction" 
                                 referencedTableName="m_loan_transaction" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_partial_writeoff_audit" baseColumnNames="initiated_by" 
                                 constraintName="fk_partial_writeoff_audit_initiated_by" 
                                 referencedTableName="m_appuser" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_partial_writeoff_audit" baseColumnNames="approved_by" 
                                 constraintName="fk_partial_writeoff_audit_approved_by" 
                                 referencedTableName="m_appuser" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_partial_writeoff_audit" baseColumnNames="office_id" 
                                 constraintName="fk_partial_writeoff_audit_office" 
                                 referencedTableName="m_office" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="CGLT-680-4" author="inkomoko" runOnChange="true">
        <comment>Add unique constraint on external_id for partial write-off audit</comment>
        <addUniqueConstraint tableName="m_partial_writeoff_audit" columnNames="external_id" 
                            constraintName="unique_partial_writeoff_audit_external_id"/>
    </changeSet>

    <changeSet id="CGLT-680-5" author="inkomoko" runOnChange="true">
        <comment>Fix column names to match AbstractAuditableWithUTCDateTimeCustom expectations</comment>
        <sql>
            ALTER TABLE m_partial_writeoff_audit 
            CHANGE COLUMN created_date created_on_utc TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
            CHANGE COLUMN last_modified_date last_modified_on_utc TIMESTAMP
        </sql>
    </changeSet>

</databaseChangeLog>
