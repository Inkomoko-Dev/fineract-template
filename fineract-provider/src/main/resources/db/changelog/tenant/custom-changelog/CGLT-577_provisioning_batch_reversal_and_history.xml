<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-history-id-to-provisioning-batch" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch"/>
                <not>
                    <columnExists tableName="m_provisioning_batch" columnName="provisioning_history_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="m_provisioning_batch">
            <column name="provisioning_history_id" type="BIGINT"/>
        </addColumn>
        <createIndex
                tableName="m_provisioning_batch"
                indexName="idx_provisioning_batch_history">
            <column name="provisioning_history_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-reversal-flag-to-provisioning-batch-journal" author="omoi">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch_journal"/>
                <not>
                    <columnExists tableName="m_provisioning_batch_journal" columnName="is_reversal"/>
                </not>
            </and>
        </preConditions>
        <!-- Distinguishes original office/currency journals from mirrored
             reversals of a prior period. Only non-reversal journals of the
             previous batch are reversed into a new batch, so a later period
             does not reverse-the-reversal and re-post older provisions. -->
        <addColumn tableName="m_provisioning_batch_journal">
            <column name="is_reversal" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reversed_journal_id" type="BIGINT"/>
            <column name="provisioning_history_id" type="BIGINT"/>
        </addColumn>
        <createIndex
                tableName="m_provisioning_batch_journal"
                indexName="idx_provisioning_batch_journal_reversal">
            <column name="is_reversal"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
