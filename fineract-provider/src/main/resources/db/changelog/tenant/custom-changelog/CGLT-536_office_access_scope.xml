<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-536-office-access-table" author="wmnjugunaink">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_appuser_office"/>
            </not>
        </preConditions>
        <createTable tableName="m_appuser_office">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="appuser_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="office_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_appuser_office" columnNames="appuser_id, office_id"
                             constraintName="unique_appuser_office"/>
        <addForeignKeyConstraint baseTableName="m_appuser_office" baseColumnNames="appuser_id"
                                 constraintName="fk_m_appuser_office_appuser_id"
                                 referencedTableName="m_appuser" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_appuser_office" baseColumnNames="office_id"
                                 constraintName="fk_m_appuser_office_office_id"
                                 referencedTableName="m_office" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="CGLT-536-office-access-permission" author="wmnjugunaink">
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('authorisation', 'HIERARCHICAL_OFFICEACCESS', 'OFFICEACCESS', 'HIERARCHICAL', 0)
            ON DUPLICATE KEY UPDATE `grouping` = 'authorisation', entity_name = 'OFFICEACCESS', action_name = 'HIERARCHICAL', can_maker_checker = 0
        </sql>
    </changeSet>

    <changeSet id="CGLT-536-office-access-strict-scope" author="wmnjugunaink">
        <sql>
            INSERT INTO c_configuration (name, value, enabled, is_trap_door, description)
            VALUES ('strict-office-scope', NULL, 0, 0,
            'When enabled, a user sees only their own and assigned offices, and their child offices only with HIERARCHICAL_OFFICEACCESS. When disabled, every user sees their own and assigned offices and every office beneath them.')
            ON DUPLICATE KEY UPDATE description = VALUES(description)
        </sql>
    </changeSet>

    <changeSet id="CGLT-536-office-access-drop-multilocation" author="wmnjugunaink">
        <sql>
            DELETE rp FROM m_role_permission rp JOIN m_permission p ON p.id = rp.permission_id WHERE p.code = 'MULTILOCATION_OFFICEACCESS'
        </sql>
        <sql>
            DELETE FROM m_permission WHERE code = 'MULTILOCATION_OFFICEACCESS'
        </sql>
    </changeSet>

</databaseChangeLog>
