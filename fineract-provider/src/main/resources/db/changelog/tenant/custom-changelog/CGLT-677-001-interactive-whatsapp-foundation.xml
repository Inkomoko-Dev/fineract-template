<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260903-677-01-conversation-session" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="whatsapp_conversation_session"/>
            </not>
        </preConditions>
        <createTable tableName="whatsapp_conversation_session">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="phone_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="conversation_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT"/>
            <column name="staff_id" type="BIGINT"/>
            <column name="language_code" type="VARCHAR(15)"/>
            <column name="session_status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="current_menu_key" type="VARCHAR(100)"/>
            <column name="authenticated" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="auth_expires_at" type="datetime"/>
            <column name="last_activity_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="datetime"/>
            <column name="created_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="lastmodified_date" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_whatsapp_session_phone_active" tableName="whatsapp_conversation_session">
            <column name="phone_number"/>
            <column name="conversation_type"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260903-677-02-consent-record" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="whatsapp_consent_record"/>
            </not>
        </preConditions>
        <createTable tableName="whatsapp_consent_record">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="phone_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT"/>
            <column name="consent_granted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="consent_source" type="VARCHAR(50)"/>
            <column name="terms_version" type="VARCHAR(50)"/>
            <column name="recorded_by_user_id" type="BIGINT"/>
            <column name="created_date" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_whatsapp_consent_phone" tableName="whatsapp_consent_record">
            <column name="phone_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260903-677-03-opt-out-record" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="whatsapp_opt_out_record"/>
            </not>
        </preConditions>
        <createTable tableName="whatsapp_opt_out_record">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="phone_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="keyword" type="VARCHAR(50)"/>
            <column name="created_date" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_whatsapp_opt_out_phone" tableName="whatsapp_opt_out_record">
            <column name="phone_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260903-677-04-menu-config" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="whatsapp_menu_option"/>
            </not>
        </preConditions>
        <createTable tableName="whatsapp_menu_option">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="menu_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="language_code" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="option_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="option_label" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="action_target" type="VARCHAR(100)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="menu_key,language_code,option_number"
                             constraintName="uk_whatsapp_menu_option"
                             tableName="whatsapp_menu_option"/>
    </changeSet>

