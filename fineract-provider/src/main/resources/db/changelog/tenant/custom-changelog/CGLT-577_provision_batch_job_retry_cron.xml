<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Original cron was once a year (1 Jan), so failed Odoo posts never retried.
         Run daily at 02:00 so CREATED/FAILED provision journals are retried. -->
    <changeSet id="cglt-577-update-provision-batch-job-cron" author="omoi">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM job WHERE name = 'Process And Post Provision Journal Entries'
            </sqlCheck>
        </preConditions>
        <update tableName="job">
            <column name="cron_expression" value="0 0 2 * * ?"/>
            <where>name = 'Process And Post Provision Journal Entries'</where>
        </update>
    </changeSet>

</databaseChangeLog>
