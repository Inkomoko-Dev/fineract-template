<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="CGLT-539-unmap-loanProductId-from-loan-payments-due" author="nickson@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM stretchy_report_parameter srp
                JOIN stretchy_report sr ON sr.id = srp.report_id
                WHERE sr.report_name = 'Loan payments due'
                AND srp.parameter_id = 25
            </sqlCheck>
        </preConditions>

        <delete tableName="stretchy_report_parameter">
            <where>
                report_id = (SELECT id FROM stretchy_report WHERE report_name = 'Loan payments due')
                AND parameter_id = 25
            </where>
        </delete>
    </changeSet>

</databaseChangeLog>