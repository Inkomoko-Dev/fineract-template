<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        CGLT-676: Align whatsapp_campaign.message_type column default with
        @Enumerated(EnumType.STRING) enum name TEMPLATE. CGLT-676-002 left
        defaultValue="template" (lowercase); do not edit that applied changeSet.
    -->
    <changeSet id="20261106-01-whatsapp-campaign-message-type-default" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="whatsapp_campaign" columnName="message_type"/>
        </preConditions>
        <addDefaultValue tableName="whatsapp_campaign" columnName="message_type" defaultValue="TEMPLATE"/>
    </changeSet>

</databaseChangeLog>
