<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-670_add_enable_third_party_disbursement_flag_to_m_product_loan" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_product_loan" columnName="enable_third_party_disbursement"/>
            </not>
        </preConditions>
        <addColumn tableName="m_product_loan">
            <column name="enable_third_party_disbursement" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="CGLT-670_migrate_product_flag_from_disbursement_provider_mapping" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="m_product_loan" columnName="enable_third_party_disbursement"/>
                <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
            </and>
        </preConditions>
        <sql>
            UPDATE m_product_loan lp
            SET enable_third_party_disbursement = true
            WHERE EXISTS (
                SELECT 1 FROM m_loan_product_disbursement_provider_mapping m
                WHERE m.loan_product_id = lp.id AND m.is_active = true
            );
        </sql>
    </changeSet>

    <changeSet id="CGLT-670_add_third_party_disbursement_provider_to_m_loan" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan" columnName="third_party_disbursement_provider"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan">
            <column name="third_party_disbursement_provider" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="CGLT-670_migrate_loan_provider_from_product_mapping" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="m_loan" columnName="third_party_disbursement_provider"/>
                <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
            </and>
        </preConditions>
        <sql>
            UPDATE m_loan l
            INNER JOIN m_loan_product_disbursement_provider_mapping m ON m.loan_product_id = l.product_id
            SET l.third_party_disbursement_provider = m.disbursement_provider_code
            WHERE m.is_active = true
              AND l.third_party_disbursement_provider IS NULL;
        </sql>
    </changeSet>

    <changeSet id="CGLT-670_drop_loan_product_disbursement_provider_mapping" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="m_loan_product_disbursement_provider_mapping"
                                  constraintName="fk_lpdpm_disbursement_provider"/>
        <dropForeignKeyConstraint baseTableName="m_loan_product_disbursement_provider_mapping"
                                  constraintName="fk_lpdpm_loan_product"/>
        <dropTable tableName="m_loan_product_disbursement_provider_mapping"/>
    </changeSet>

</databaseChangeLog>
