<?xml version="1.0" encoding="UTF-8"?>
<!--
    Permission for reversing a single loan accrual transaction (with journal entries).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="nelsonomoi" id="CGLT-851_add_permission_REVERSEACCRUAL_LOAN">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'REVERSEACCRUAL_LOAN'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="REVERSEACCRUAL_LOAN"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="REVERSEACCRUAL"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="REVERSEACCRUAL_LOAN_CHECKER"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="REVERSEACCRUAL_CHECKER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
