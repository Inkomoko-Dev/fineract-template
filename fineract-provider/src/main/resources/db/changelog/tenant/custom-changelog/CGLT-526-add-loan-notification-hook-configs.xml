<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet id="add_loan_email_hooks" author="nickson@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_hook_templates"/>
            <tableExists tableName="m_hook"/>
            <tableExists tableName="m_hook_registered_events"/>
        </preConditions>

        <!-- 1. Insert hook template first -->
        <insert tableName="m_hook_templates">
            <column name="name" value="Email Gateway"/>
        </insert>

        <!-- 2. Insert the hook referencing the template -->
        <insert tableName="m_hook">
            <column name="template_id" valueComputed="(SELECT id FROM m_hook_templates WHERE name='Email Gateway')"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="name" value="Loan Email Notifications"/>
            <column name="createdby_id" valueNumeric="1"/>
            <column name="created_date" valueDate="NOW()"/>
            <column name="lastmodifiedby_id" valueNumeric="NULL"/>
            <column name="lastmodified_date" valueDate="NULL"/>
            <column name="ugd_template_id" valueNumeric="NULL"/>
        </insert>

        <!-- 3. Register hook for REJECT -->
        <insert tableName="m_hook_registered_events">
            <column name="hook_id" valueComputed="(SELECT id FROM m_hook WHERE name='Loan Email Notifications')"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="REJECT"/>
        </insert>

        <!-- 4. Register hook for APPROVE -->
        <insert tableName="m_hook_registered_events">
            <column name="hook_id" valueComputed="(SELECT id FROM m_hook WHERE name='Loan Email Notifications')"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="APPROVE"/>
        </insert>
    </changeSet>
</databaseChangeLog>