<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-680-1" author="inkomoko" runOnChange="true">
        <comment>Add partial write-off permissions</comment>
        <sql>
            INSERT INTO m_permission (grouping, code, entity_name, action_name, can_maker_checker)
            VALUES ('transaction_loan', 'PARTIALWRITEOFF_LOAN', 'LOAN', 'PARTIALWRITEOFF', 1)
            ON DUPLICATE KEY UPDATE can_maker_checker = 1
        </sql>
    </changeSet>

    <changeSet id="CGLT-680-3" author="inkomoko">
        <comment>Update partial write-off permission to enable maker-checker workflow</comment>
        <update tableName="m_permission">
            <column name="can_maker_checker" valueBoolean="true"/>
            <where>code = 'PARTIALWRITEOFF_LOAN'</where>
        </update>
    </changeSet>

</databaseChangeLog>
