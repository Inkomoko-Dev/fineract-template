<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="Felix Mutua" id="add_kifiya_webhook_url">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM c_configuration WHERE name = 'kifiya-webhook-url'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="c_configuration">
            <column name="name" value="kifiya-webhook-url" />
            <column name="value" value="0" />
            <column name="string_value" value="" />
            <column name="enabled" valueBoolean="false" />
            <column name="description" value="Webhook URL for Kifiya third-party disbursement product notifications" />
        </insert>
    </changeSet>

    <changeSet author="Felix Mutua" id="add_kifiya_webhook_enabled">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM c_configuration WHERE name = 'kifiya-webhook-enabled'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="c_configuration">
            <column name="name" value="kifiya-webhook-enabled" />
            <column name="value" value="0" />
            <column name="enabled" valueBoolean="true" />
            <column name="description" value="Enable/disable Kifiya webhook notifications for loan product changes" />
        </insert>
    </changeSet>

    <changeSet author="Felix Mutua" id="add_kifiya_webhook_api_key">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM c_configuration WHERE name = 'kifiya-webhook-api-key'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="c_configuration">
            <column name="name" value="kifiya-webhook-api-key" />
            <column name="value" value="0" />
            <column name="string_value" value="" />
            <column name="enabled" valueBoolean="true" />
            <column name="description" value="API key for Kifiya webhook authentication" />
        </insert>
    </changeSet>

    <!-- Generic partner webhook configuration (for future partners) -->
    <changeSet author="Felix Mutua" id="add_partner_webhook_config">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM c_configuration WHERE name = 'partner-webhook-config'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="c_configuration">
            <column name="name" value="partner-webhook-config" />
            <column name="value" value="0" />
            <column name="string_value" value="{}" />
            <column name="enabled" valueBoolean="false" />
            <column name="description" value="JSON configuration for multiple partner webhooks (e.g., {&quot;KIFIYA&quot;:{&quot;url&quot;:&quot;https://...&quot;,&quot;enabled&quot;:true}})" />
        </insert>
    </changeSet>
</databaseChangeLog>
