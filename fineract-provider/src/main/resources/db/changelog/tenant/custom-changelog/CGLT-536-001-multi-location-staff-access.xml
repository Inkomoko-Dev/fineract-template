<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-536-1" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_appuser_office"/>
            </not>
        </preConditions>
        <comment>Additional office assignments for a user, for multi-location access</comment>
        <createTable tableName="m_appuser_office">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="appuser_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="office_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_appuser_office" columnNames="appuser_id, office_id"
                             constraintName="unique_appuser_office"/>
        <addForeignKeyConstraint baseTableName="m_appuser_office" baseColumnNames="appuser_id"
                                 constraintName="fk_m_appuser_office_appuser_id"
                                 referencedTableName="m_appuser" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_appuser_office" baseColumnNames="office_id"
                                 constraintName="fk_m_appuser_office_office_id"
                                 referencedTableName="m_office" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="CGLT-536-2" author="inkomoko" runOnChange="true">
        <comment>Permission granting hierarchical and multi-location office access</comment>
        <sql>
            INSERT INTO m_permission (`grouping`, code, entity_name, action_name, can_maker_checker)
            VALUES ('authorisation', 'HIERARCHICAL_OFFICEACCESS', 'OFFICEACCESS', 'HIERARCHICAL', 0)
            ON DUPLICATE KEY UPDATE `grouping` = 'authorisation'
        </sql>
    </changeSet>

    <changeSet id="CGLT-536-3" author="inkomoko" runOnChange="true">
        <comment>Strict office scoping, disabled so that existing users keep their current visibility</comment>
        <sql>
            INSERT INTO c_configuration (name, value, enabled, is_trap_door, description)
            VALUES ('strict-office-scope', NULL, 0, 0,
            'When enabled, a user without the HIERARCHICAL_OFFICEACCESS permission sees only their own office, with no child offices. When disabled, such a user keeps the platform default of seeing their own office and every office beneath it.')
            ON DUPLICATE KEY UPDATE description = VALUES(description)
        </sql>
    </changeSet>

</databaseChangeLog>
