<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Disbursement provider registry (codes referenced by product mapping) -->
    <changeSet id="CGLT-657_create_m_disbursement_provider" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_disbursement_provider"/>
            </not>
        </preConditions>
        <createTable tableName="m_disbursement_provider">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="CGLT-657_seed_disbursement_provider_kifiya" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_disbursement_provider WHERE code = 'KIFIYA'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_disbursement_provider">
            <column name="code" value="KIFIYA"/>
            <column name="name" value="Kifiya"/>
            <column name="description" value="Kifiya third-party disbursement service provider"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!-- Replace product columns with loan-product ↔ provider mapping table -->
    <changeSet id="CGLT-657_create_m_loan_product_disbursement_provider_mapping" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_product_disbursement_provider_mapping">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="loan_product_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="disbursement_provider_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_loan_product_disbursement_provider_mapping"
                                 baseColumnNames="loan_product_id"
                                 constraintName="fk_lpdpm_loan_product"
                                 referencedTableName="m_product_loan"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="CGLT-657_migrate_third_party_disbursement_from_product_columns" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
                <columnExists tableName="m_product_loan" columnName="enable_third_party_disbursement"/>
                <columnExists tableName="m_product_loan" columnName="third_party_disbursement_provider"/>
            </and>
        </preConditions>
        <sql>
            INSERT INTO m_loan_product_disbursement_provider_mapping (loan_product_id, disbursement_provider_code, is_active)
            SELECT lp.id, lp.third_party_disbursement_provider, lp.enable_third_party_disbursement
            FROM m_product_loan lp
            WHERE lp.enable_third_party_disbursement = true
              AND lp.third_party_disbursement_provider IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1 FROM m_loan_product_disbursement_provider_mapping m WHERE m.loan_product_id = lp.id
              );
        </sql>
    </changeSet>

    <changeSet id="CGLT-657_drop_enable_third_party_disbursement_from_m_product_loan" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_product_loan" columnName="enable_third_party_disbursement"/>
        </preConditions>
        <dropColumn tableName="m_product_loan" columnName="enable_third_party_disbursement"/>
    </changeSet>

    <changeSet id="CGLT-657_drop_third_party_disbursement_provider_from_m_product_loan" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_product_loan" columnName="third_party_disbursement_provider"/>
        </preConditions>
        <dropColumn tableName="m_product_loan" columnName="third_party_disbursement_provider"/>
    </changeSet>

    <changeSet id="CGLT-657_sync_mapping_codes_to_disbursement_provider_registry" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_disbursement_provider"/>
                <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
            </and>
        </preConditions>
        <sql>
            INSERT INTO m_disbursement_provider (code, name, is_active)
            SELECT DISTINCT m.disbursement_provider_code, m.disbursement_provider_code, true
            FROM m_loan_product_disbursement_provider_mapping m
            WHERE NOT EXISTS (
                SELECT 1 FROM m_disbursement_provider dp WHERE dp.code = m.disbursement_provider_code
            );
        </sql>
    </changeSet>

    <changeSet id="CGLT-657_add_fk_mapping_to_disbursement_provider" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_disbursement_provider"/>
                <tableExists tableName="m_loan_product_disbursement_provider_mapping"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="fk_lpdpm_disbursement_provider"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseTableName="m_loan_product_disbursement_provider_mapping"
                                 baseColumnNames="disbursement_provider_code"
                                 constraintName="fk_lpdpm_disbursement_provider"
                                 referencedTableName="m_disbursement_provider"
                                 referencedColumnNames="code"/>
    </changeSet>

</databaseChangeLog>
