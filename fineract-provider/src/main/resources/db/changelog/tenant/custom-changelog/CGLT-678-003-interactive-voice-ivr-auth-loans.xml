<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260907-678-07-voice-ivr-session-auth" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="voice_ivr_session" columnName="session_context"/>
            </not>
        </preConditions>
        <addColumn tableName="voice_ivr_session">
            <column name="session_context" type="TEXT"/>
            <column name="authenticated" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="auth_expires_at" type="DATETIME"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260907-678-08-main-loans-submenu" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM voice_ivr_menu_option WHERE menu_key = 'MAIN' AND language_code = 'en' AND option_digit = 1 AND action_type = 'DIAL'</sqlCheck>
        </preConditions>
        <update tableName="voice_ivr_menu_option">
            <column name="option_label" value="Loan self-service"/>
            <column name="action_type" value="SUBMENU"/>
            <column name="action_target" value="LOAN"/>
            <where>menu_key = 'MAIN' AND language_code = 'en' AND option_digit = 1</where>
        </update>
        <update tableName="voice_ivr_menu_option">
            <column name="option_label" value="Serivisi y'inguzanyo"/>
            <column name="action_type" value="SUBMENU"/>
            <column name="action_target" value="LOAN"/>
            <where>menu_key = 'MAIN' AND language_code = 'rw' AND option_digit = 1</where>
        </update>
    </changeSet>

    <changeSet id="20260907-678-09-seed-loan-submenu" author="inkomoko">
        <preConditions onFail="MARK_RAN">
