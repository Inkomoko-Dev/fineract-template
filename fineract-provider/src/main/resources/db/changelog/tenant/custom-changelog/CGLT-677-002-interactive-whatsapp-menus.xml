        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM whatsapp_menu_option WHERE menu_key = 'INFO'</sqlCheck>
        </preConditions>
        <insert tableName="whatsapp_menu_option">
