            <column name="body_text" value="Inkomoko offers business training for entrepreneurs. Visit your nearest Inkomoko office or speak to an advisor for upcoming sessions."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_content_message">
            <column name="content_key" value="TRAINING"/>
            <column name="language_code" value="rw"/>
            <column name="body_text" value="Inkomoko itanga amahugurwa y'ubucuruzi. Sura icyumba cy'Inkomoko cyangwa uvugana n'umujyanama kugira ngo umenye amasomo azaza."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_content_message">
            <column name="content_key" value="MARKET_LINKAGE"/>
            <column name="language_code" value="en"/>
            <column name="body_text" value="Market linkage connects your business to buyers and suppliers. Reply MENU for options or choose 7 to speak to an advisor."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_content_message">
            <column name="content_key" value="MARKET_LINKAGE"/>
            <column name="language_code" value="rw"/>
            <column name="body_text" value="Guhuza isoko bifasha ubucuruzi bwawe kubona abaguzi n'abatanga ibicuruzwa. Andika MENU cyangwa hitamo 7 kuvugana n'umujyanama."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

