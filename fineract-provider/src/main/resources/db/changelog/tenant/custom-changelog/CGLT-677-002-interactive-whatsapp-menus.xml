<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260903-677-07-session-context" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="whatsapp_conversation_session" columnName="session_context"/>
            </not>
        </preConditions>
        <addColumn tableName="whatsapp_conversation_session">
            <column name="session_context" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260903-677-08-menu-definition" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="whatsapp_menu_definition"/>
            </not>
        </preConditions>
        <createTable tableName="whatsapp_menu_definition">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="menu_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="language_code" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="header_text" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_menu_key" type="VARCHAR(100)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="menu_key,language_code"
                             constraintName="uk_whatsapp_menu_definition"
                             tableName="whatsapp_menu_definition"/>
    </changeSet>

    <changeSet id="20260903-677-09-content-message" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="whatsapp_content_message"/>
            </not>
        </preConditions>
        <createTable tableName="whatsapp_content_message">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="content_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="language_code" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="body_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="content_key,language_code"
                             constraintName="uk_whatsapp_content_message"
                             tableName="whatsapp_content_message"/>
    </changeSet>

    <changeSet id="20260903-677-10-seed-menu-definitions" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM whatsapp_menu_definition WHERE menu_key = 'MAIN'</sqlCheck>
        </preConditions>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="en"/>
            <column name="header_text" value="Welcome to Inkomoko. Please choose an option:"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="header_text" value="Murakaza neza kuri Inkomoko. Hitamo:"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="LOAN"/>
            <column name="language_code" value="en"/>
            <column name="header_text" value="Loan self-service (authentication required in next release):"/>
            <column name="parent_menu_key" value="MAIN"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="LOAN"/>
            <column name="language_code" value="rw"/>
            <column name="header_text" value="Serivisi y'inguzanyo (kwemeza bizaza):"/>
            <column name="parent_menu_key" value="MAIN"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="INFO"/>
            <column name="language_code" value="en"/>
            <column name="header_text" value="Business support information:"/>
            <column name="parent_menu_key" value="MAIN"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="INFO"/>
            <column name="language_code" value="rw"/>
            <column name="header_text" value="Amakuru y'ubufasha mu bucuruzi:"/>
            <column name="parent_menu_key" value="MAIN"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="20260903-677-11-seed-content-messages" author="inkomoko">
