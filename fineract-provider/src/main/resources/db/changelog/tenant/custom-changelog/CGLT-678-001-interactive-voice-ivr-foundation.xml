<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260907-678-01-voice-ivr-menu-definition" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="voice_ivr_menu_definition"/>
            </not>
        </preConditions>
        <createTable tableName="voice_ivr_menu_definition">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="menu_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="language_code" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_text" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_menu_key" type="VARCHAR(100)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="menu_key,language_code"
                             constraintName="uk_voice_ivr_menu_definition"
                             tableName="voice_ivr_menu_definition"/>
    </changeSet>

    <changeSet id="20260907-678-02-voice-ivr-menu-option" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="voice_ivr_menu_option"/>
            </not>
        </preConditions>
        <createTable tableName="voice_ivr_menu_option">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="menu_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="language_code" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="option_digit" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="option_label" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="action_target" type="VARCHAR(100)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="menu_key,language_code,option_digit"
                             constraintName="uk_voice_ivr_menu_option"
                             tableName="voice_ivr_menu_option"/>
    </changeSet>

    <changeSet id="20260907-678-03-voice-ivr-session" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="voice_ivr_session"/>
            </not>
        </preConditions>
        <createTable tableName="voice_ivr_session">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="external_session_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="caller_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT"/>
            <column name="staff_id" type="BIGINT"/>
            <column name="language_code" type="VARCHAR(15)"/>
            <column name="session_status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="current_menu_key" type="VARCHAR(100)"/>
            <column name="parent_menu_key" type="VARCHAR(100)"/>
            <column name="last_activity_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="DATETIME"/>
            <column name="created_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="lastmodified_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_voice_ivr_session_external_id" tableName="voice_ivr_session">
            <column name="external_session_id"/>
        </createIndex>
        <createIndex indexName="idx_voice_ivr_session_caller_number" tableName="voice_ivr_session">
            <column name="caller_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260907-678-04-seed-main-menu" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM voice_ivr_menu_definition WHERE menu_key = 'MAIN'</sqlCheck>
        </preConditions>
        <insert tableName="voice_ivr_menu_definition">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="en"/>
            <column name="prompt_text" value="Welcome to Inkomoko."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="voice_ivr_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="en"/>
            <column name="option_digit" valueNumeric="1"/>
            <column name="option_label" value="Loans"/>
            <column name="action_type" value="DIAL"/>
            <column name="action_target" value="LOANS"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="voice_ivr_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="en"/>
            <column name="option_digit" valueNumeric="2"/>
            <column name="option_label" value="Client Support"/>
            <column name="action_type" value="DIAL"/>
            <column name="action_target" value="SUPPORT"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="voice_ivr_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="en"/>
            <column name="option_digit" valueNumeric="3"/>
            <column name="option_label" value="Internal Staff"/>
            <column name="action_type" value="DIAL"/>
            <column name="action_target" value="STAFF"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
