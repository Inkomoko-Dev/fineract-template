<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-office-and-payload-to-provisioning-batch-journal" author="omoi">

        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_provisioning_batch_journal"/>
                <not>
                    <columnExists tableName="m_provisioning_batch_journal" columnName="office_id"/>
                </not>
            </and>
        </preConditions>

        <!-- The Fineract office (entity) an aggregated journal belongs to.
             Two offices can share a currency (e.g. Inkomoko Kenya and
             Inkomoko Capital both use KES) but must be posted as separate
             journals since they are different entities with their own
             provisioning criteria. -->
        <addColumn tableName="m_provisioning_batch_journal">
            <column name="office_id" type="BIGINT"/>
            <column name="office_name" type="VARCHAR(150)"/>
            <!-- The JournalData/JournalItemData payload built for Odoo,
                 kept for review before/without a live post. -->
            <column name="payload_json" type="TEXT"/>
        </addColumn>

        <createIndex
                tableName="m_provisioning_batch_journal"
                indexName="idx_provisioning_batch_journal_office">
            <column name="office_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
