<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260909-01-novu-external-service" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM c_external_service WHERE name = 'NOVU'</sqlCheck>
        </preConditions>
        <insert tableName="c_external_service">
            <column name="name" value="NOVU"/>
        </insert>
        <sql>
            INSERT INTO c_external_service_properties (name, value, external_service_id)
            SELECT p.name, p.value, es.id
            FROM c_external_service es
            JOIN (
                SELECT 'api_url' name, 'https://api.novu.co' value
                UNION ALL SELECT 'api_key', ''
                UNION ALL SELECT 'enabled', 'false'
                UNION ALL SELECT 'timeout_seconds', '10'
            ) p
            WHERE es.name = 'NOVU';
        </sql>
    </changeSet>

    <changeSet id="20260909-02-novu-campaign" author="inkomoko">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="novu_campaign"/></not></preConditions>
        <createTable tableName="novu_campaign">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="campaign_name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="workflow_id" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="event_type" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="recipient_type" type="VARCHAR(20)" defaultValue="CLIENT"><constraints nullable="false"/></column>
            <column name="channels" type="VARCHAR(100)" defaultValue="IN_APP,EMAIL,SMS"><constraints nullable="false"/></column>
            <column name="email_subject" type="VARCHAR(255)"/>
            <column name="email_body" type="TEXT"/>
            <column name="sms_body" type="VARCHAR(1000)"/>
            <column name="in_app_body" type="VARCHAR(1000)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on" type="DATETIME"><constraints nullable="false"/></column>
            <column name="last_modified_on" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="novu_campaign" columnNames="campaign_name" constraintName="uk_novu_campaign_name"/>
        <createIndex tableName="novu_campaign" indexName="idx_novu_campaign_event_active">
            <column name="event_type"/><column name="active"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260909-03-novu-notification-log" author="inkomoko">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="novu_notification_log"/></not></preConditions>
        <createTable tableName="novu_notification_log">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="campaign_id" type="BIGINT"/>
            <column name="event_type" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="workflow_id" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="subscriber_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="recipient_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="channel" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="transaction_id" type="VARCHAR(100)"/>
            <column name="response_message" type="VARCHAR(1000)"/>
            <column name="created_on" type="DATETIME"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="novu_notification_log" indexName="idx_novu_log_created"><column name="created_on"/></createIndex>
        <createIndex tableName="novu_notification_log" indexName="idx_novu_log_transaction"><column name="transaction_id"/></createIndex>
    </changeSet>

