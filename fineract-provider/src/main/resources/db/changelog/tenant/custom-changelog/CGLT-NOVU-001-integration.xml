    <changeSet id="20260911-09-novu-campaign-delivery-modes" author="inkomoko">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="novu_campaign" columnName="trigger_type"/></not></preConditions>
        <addColumn tableName="novu_campaign">
            <column name="trigger_type" type="VARCHAR(20)" defaultValue="TRIGGERED"><constraints nullable="false"/></column>
            <column name="chat_body" type="VARCHAR(1000)"/>
            <column name="report_name" type="VARCHAR(255)"/>
            <column name="param_value" type="TEXT"/>
            <column name="recurrence" type="VARCHAR(255)"/>
            <column name="recurrence_start_date" type="DATETIME"/>
            <column name="next_trigger_date" type="DATETIME"/>
            <column name="last_trigger_date" type="DATETIME"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260911-10-novu-schedule-index" author="inkomoko">
        <preConditions onFail="MARK_RAN"><not><indexExists tableName="novu_campaign" indexName="idx_novu_campaign_schedule"/></not></preConditions>
        <createIndex tableName="novu_campaign" indexName="idx_novu_campaign_schedule">
            <column name="trigger_type"/><column name="active"/><column name="next_trigger_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260911-11-novu-scheduled-campaign-job" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM job WHERE name = 'Process Novu Scheduled Campaigns'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Process Novu Scheduled Campaigns"/>
            <column name="display_name" value="Process Novu Scheduled Campaigns"/>
            <column name="cron_expression" value="0 */5 * * * ?"/>
            <column name="create_time" valueDate="NOW()"/>
            <column name="task_priority" valueNumeric="3"/>
            <column name="group_name"/>
            <column name="job_key" value="Process Novu Scheduled Campaigns _ DEFAULT"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
