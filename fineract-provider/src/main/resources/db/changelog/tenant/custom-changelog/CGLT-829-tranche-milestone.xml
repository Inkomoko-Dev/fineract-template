<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="inkomoko" id="CGLT-829-milestone-columns">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_product_loan" columnName="require_milestone_survey"/>
            </not>
        </preConditions>
        <addColumn tableName="m_product_loan">
            <column name="require_milestone_survey" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createTable tableName="m_loan_tranche_milestone">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="disbursement_detail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="submission_id" type="VARCHAR(100)"/>
            <column name="conducted_by" type="VARCHAR(200)"/>
            <column name="conducted_on" type="DATE"/>
            <column name="operational_status" type="VARCHAR(32)"/>
            <column name="operational_verified_by_bgs" type="BOOLEAN"/>
            <column name="operational_bgs_name" type="VARCHAR(200)"/>
            <column name="operational_verified_by_investment" type="BOOLEAN"/>
            <column name="operational_investment_name" type="VARCHAR(200)"/>
            <column name="additional_funding" type="VARCHAR(32)"/>
            <column name="funding_verified_by_bgs" type="BOOLEAN"/>
            <column name="funding_bgs_name" type="VARCHAR(200)"/>
            <column name="funding_verified_by_investment" type="BOOLEAN"/>
            <column name="funding_investment_name" type="VARCHAR(200)"/>
            <column name="submitted_on" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_loan_tranche_milestone" columnNames="loan_id,disbursement_detail_id"
                             constraintName="uk_tranche_milestone_tranche"/>
        <addUniqueConstraint tableName="m_loan_tranche_milestone" columnNames="submission_id"
                             constraintName="uk_tranche_milestone_submission"/>
        <createTable tableName="m_loan_tranche_milestone_history">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="disbursement_detail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="submission_id" type="VARCHAR(100)"/>
            <column name="conducted_by" type="VARCHAR(200)"/>
            <column name="conducted_on" type="DATE"/>
            <column name="operational_status" type="VARCHAR(32)"/>
            <column name="additional_funding" type="VARCHAR(32)"/>
            <column name="loan_sub_status_id" type="INT"/>
            <column name="recorded_on" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="inkomoko" id="CGLT-829-milestone-permission">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'CREATE_TRANCHEMILESTONE'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="CREATE_TRANCHEMILESTONE"/>
            <column name="entity_name" value="TRANCHEMILESTONE"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet author="inkomoko" id="CGLT-829-milestone-job">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM job WHERE name = 'Refresh Tranche Milestone Status'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Refresh Tranche Milestone Status"/>
            <column name="display_name" value="Refresh Tranche Milestone Status"/>
            <column name="cron_expression" value="0 15 0 1/1 * ? *"/>
            <column name="create_time" valueDate="NOW()"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="job_key" value="Refresh Tranche Milestone Status _ DEFAULT"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="inkomoko" id="CGLT-829-milestone-status-parameter">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM stretchy_parameter WHERE parameter_name = 'trancheMilestoneStatusSelectAll'
            </sqlCheck>
        </preConditions>
        <insert tableName="stretchy_parameter">
            <column name="parameter_name" value="trancheMilestoneStatusSelectAll"/>
            <column name="parameter_variable" value="trancheMilestoneStatusId"/>
            <column name="parameter_label" value="Tranche status"/>
            <column name="parameter_displayType" value="select"/>
            <column name="parameter_FormatType" value="number"/>
            <column name="parameter_default" value="-1"/>
            <column name="selectAll" value="Y"/>
            <column name="parameter_sql"><![CDATA[(select 400 as id, 'Repayment conditions not met' as name) union all (select 410, 'Repayment conditions met') union all (select 420, 'Awaiting survey') union all (select 430, 'Survey successful') union all (select 440, 'Expired') union all (select 450, 'Requires review')]]></column>
        </insert>
    </changeSet>

    <changeSet author="inkomoko" id="CGLT-829-milestone-report">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                select count(*) from stretchy_report where report_name = 'Multi-tranche eligibility'
            </sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Multi-tranche eligibility"/>
            <column name="report_type" value="Table"/>
            <column name="report_category" value="Loan"/>
            <column name="description" value="Multi-tranche loans and the sub-status of the tranche waiting to be disbursed."/>
            <column name="self_service_user_report" valueBoolean="false"/>
            <column name="report_sql">
                <![CDATA[
SELECT
    o.name AS office,
    ms.display_name AS loanOfficer,
    mc.display_name AS clientName,
    ml.account_no AS loanAccount,
    lp.name AS product,
    (SELECT COUNT(*) + 1 FROM m_loan_disbursement_detail d
        WHERE d.loan_id = ml.id AND d.disbursedon_date IS NOT NULL) AS trancheNumber,
    CASE ml.loan_sub_status_id
        WHEN 400 THEN 'Repayment conditions not met'
        WHEN 410 THEN 'Repayment conditions met'
        WHEN 420 THEN 'Awaiting survey'
        WHEN 430 THEN 'Survey successful'
        WHEN 440 THEN 'Expired'
        WHEN 450 THEN 'Requires review'
        ELSE ''
    END AS trancheStatus,
    sched.duedate AS firstRepaymentDueDate,
    mile.operational_status AS operationalStatus,
    mile.additional_funding AS additionalFunding,
    mile.conducted_by AS conductedBy,
    mile.conducted_on AS conductedOn
FROM m_loan ml
JOIN m_product_loan lp ON lp.id = ml.product_id
LEFT JOIN m_client mc ON mc.id = ml.client_id
LEFT JOIN m_office o ON o.id = mc.office_id
LEFT JOIN m_staff ms ON ms.id = ml.loan_officer_id
LEFT JOIN m_loan_repayment_schedule sched ON sched.loan_id = ml.id AND sched.installment = 1
LEFT JOIN m_loan_disbursement_detail nxt ON nxt.loan_id = ml.id AND nxt.disbursedon_date IS NULL
    AND nxt.id = (
        SELECT n2.id FROM m_loan_disbursement_detail n2
        WHERE n2.loan_id = ml.id AND n2.disbursedon_date IS NULL
        ORDER BY n2.expected_disburse_date, n2.id
        LIMIT 1
    )
LEFT JOIN m_loan_tranche_milestone mile ON mile.loan_id = ml.id AND mile.disbursement_detail_id = nxt.id
WHERE lp.allow_multiple_disbursals = 1
  AND ml.loan_sub_status_id IN (400, 410, 420, 430, 440, 450)
  AND (ml.loan_sub_status_id = ${trancheMilestoneStatusId} OR ${trancheMilestoneStatusId} = -1)
ORDER BY ml.account_no
]]>
            </column>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet author="inkomoko" id="CGLT-829-milestone-report-parameter">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM stretchy_report_parameter srp
                JOIN stretchy_report sr ON sr.id = srp.report_id
                WHERE sr.report_name = 'Multi-tranche eligibility'
            </sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO stretchy_report_parameter (report_id, parameter_id, report_parameter_name)
            SELECT sr.id, sp.id, 'trancheMilestoneStatusId'
            FROM stretchy_report sr
            JOIN stretchy_parameter sp ON sp.parameter_name = 'trancheMilestoneStatusSelectAll'
            WHERE sr.report_name = 'Multi-tranche eligibility'
        </sql>
    </changeSet>

</databaseChangeLog>
