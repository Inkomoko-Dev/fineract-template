<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260907-677-22-staff-menu-definition" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM whatsapp_menu_definition WHERE menu_key = 'STAFF_MAIN'</sqlCheck>
        </preConditions>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="en"/>
            <column name="header_text" value="Inkomoko Employee WhatsApp. Choose an option:"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_definition">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="header_text" value="Murakaza neza kuri WhatsApp y'abakozi ba Inkomoko. Hitamo:"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="20260907-677-23-staff-content" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM whatsapp_content_message WHERE content_key = 'STAFF_HR'</sqlCheck>
        </preConditions>
        <insert tableName="whatsapp_content_message">
            <column name="content_key" value="STAFF_HR"/>
            <column name="language_code" value="en"/>
            <column name="body_text" value="Contact HR via your supervisor or email hr@inkomoko.org for leave, payroll, and policy questions."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_content_message">
            <column name="content_key" value="STAFF_HR"/>
            <column name="language_code" value="rw"/>
            <column name="body_text" value="Vugana n'umuyobozi wawe cyangwa hr@inkomoko.org ku bibazo byerekeye umushahara n'amategeko."/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="20260907-677-24-staff-menu-options" author="inkomoko">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM whatsapp_menu_option WHERE menu_key = 'STAFF_MAIN'</sqlCheck>
        </preConditions>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="en"/>
            <column name="option_number" valueNumeric="1"/>
            <column name="option_label" value="HR and Policies"/>
            <column name="action_type" value="CONTENT"/>
            <column name="action_target" value="STAFF_HR"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="en"/>
            <column name="option_number" valueNumeric="2"/>
            <column name="option_label" value="IT Support"/>
            <column name="action_type" value="ADVISOR_HANDOFF"/>
            <column name="action_target" value="STAFF_IT"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="en"/>
            <column name="option_number" valueNumeric="3"/>
            <column name="option_label" value="Other Request"/>
            <column name="action_type" value="ADVISOR_HANDOFF"/>
            <column name="action_target" value="OTHER"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="1"/>
            <column name="option_label" value="HR n'amategeko"/>
            <column name="action_type" value="CONTENT"/>
            <column name="action_target" value="STAFF_HR"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="2"/>
            <column name="option_label" value="IT Support"/>
            <column name="action_type" value="ADVISOR_HANDOFF"/>
            <column name="action_target" value="STAFF_IT"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="STAFF_MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="3"/>
            <column name="option_label" value="Ibindi bisaba"/>
            <column name="action_type" value="ADVISOR_HANDOFF"/>
            <column name="action_target" value="OTHER"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
