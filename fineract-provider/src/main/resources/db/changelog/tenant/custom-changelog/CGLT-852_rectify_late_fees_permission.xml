<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="nelsonomoi" id="CGLT-852_add_permission_RECTIFYLATEFEES_LOAN">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'RECTIFYLATEFEES_LOAN'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="RECTIFYLATEFEES_LOAN"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="RECTIFYLATEFEES"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="nelsonomoi" id="CGLT-852_grant_rectify_late_fees_to_penalty_job_roles">
        <comment>Roles that can already run the overdue penalty job can run the one-loan correction</comment>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT DISTINCT rp.role_id, rectify.id
            FROM m_role_permission rp
            JOIN m_permission source ON source.id = rp.permission_id AND source.code = 'RUNCLONEJOBFORLOANPENALTY_LOAN'
            CROSS JOIN m_permission rectify ON rectify.code = 'RECTIFYLATEFEES_LOAN'
            WHERE NOT EXISTS (
                SELECT 1 FROM m_role_permission existing
                WHERE existing.role_id = rp.role_id AND existing.permission_id = rectify.id
            )
        </sql>
    </changeSet>

</databaseChangeLog>
