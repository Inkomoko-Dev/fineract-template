<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="create-m_bulk_reschedule_execution-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_bulk_reschedule_execution"/>
            </not>
        </preConditions>
        <createTable tableName="m_bulk_reschedule_execution">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" foreignKeyName="FK_bulk_reschedule_execution_user_id" references="m_appuser(id)"/>
            </column>
            <column name="office_id" type="bigint">
                <constraints nullable="false" foreignKeyName="FK_bulk_reschedule_execution_office_id" references="m_office(id)"/>
            </column>
            <column name="status_enum" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="mode_enum" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="filters_json" type="longtext">
                <constraints nullable="true"/>
            </column>
            <column name="rescheduling_details_json" type="longtext">
                <constraints nullable="true"/>
            </column>
            <column name="approver_id" type="bigint">
                <constraints nullable="true" foreignKeyName="FK_bulk_reschedule_execution_approver_id" references="m_appuser(id)"/>
            </column>
            <column name="approval_note" type="longtext">
                <constraints nullable="true"/>
            </column>
            <column name="approved_at" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="total_loans_found" type="int">
                <constraints nullable="false" />
            </column>
            <column name="total_succeeded" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="total_failed" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="total_excluded" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_bulk_reschedule_execution" indexName="idx_bulk_reschedule_execution_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="m_bulk_reschedule_execution" indexName="idx_bulk_reschedule_execution_office_id">
            <column name="office_id"/>
        </createIndex>
        <createIndex tableName="m_bulk_reschedule_execution" indexName="idx_bulk_reschedule_execution_status">
            <column name="status_enum"/>
        </createIndex>
        <createIndex tableName="m_bulk_reschedule_execution" indexName="idx_bulk_reschedule_execution_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-bulk-reschedule-approval-workflow-metadata" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_reschedule_execution"/>
            <not><columnExists tableName="m_bulk_reschedule_execution" columnName="submitted_at"/></not>
        </preConditions>
        <addColumn tableName="m_bulk_reschedule_execution">
            <column name="submission_note" type="longtext"/>
            <column name="submitted_at" type="datetime"/>
            <column name="execution_error" type="longtext"/>
        </addColumn>
        <createIndex tableName="m_bulk_reschedule_execution" indexName="idx_bulk_reschedule_execution_approver">
            <column name="approver_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-bulk-reschedule-execution-progress-timestamps" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_reschedule_execution"/>
            <not><columnExists tableName="m_bulk_reschedule_execution" columnName="execution_started_at"/></not>
        </preConditions>
        <addColumn tableName="m_bulk_reschedule_execution">
            <column name="execution_started_at" type="datetime"/>
            <column name="execution_completed_at" type="datetime"/>
            <column name="total_execution_failed" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-bulk-reschedule-worker-lease" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_reschedule_execution"/>
            <not><columnExists tableName="m_bulk_reschedule_execution" columnName="worker_token"/></not>
        </preConditions>
        <addColumn tableName="m_bulk_reschedule_execution">
            <column name="worker_token" type="varchar(64)"/>
            <column name="lease_expires_at" type="datetime"/>
            <column name="last_heartbeat_at" type="datetime"/>
        </addColumn>
        <createIndex tableName="m_bulk_reschedule_execution" indexName="idx_bulk_reschedule_execution_lease">
            <column name="status_enum"/>
            <column name="lease_expires_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-recover-bulk-reschedule-permission" author="codex">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'RECOVER_RESCHEDULELOAN'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="loan_reschedule"/>
            <column name="code" value="RECOVER_RESCHEDULELOAN"/>
            <column name="entity_name" value="RESCHEDULELOAN"/>
            <column name="action_name" value="RECOVER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="grant-recover-bulk-reschedule-to-approvers" author="codex">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT DISTINCT rp.role_id, recover_permission.id
            FROM m_role_permission rp
            JOIN m_permission approve_permission ON approve_permission.id = rp.permission_id
                AND approve_permission.code = 'APPROVE_RESCHEDULELOAN'
            CROSS JOIN m_permission recover_permission
            WHERE recover_permission.code = 'RECOVER_RESCHEDULELOAN'
              AND NOT EXISTS (
                SELECT 1 FROM m_role_permission existing
                WHERE existing.role_id = rp.role_id AND existing.permission_id = recover_permission.id
              )
        </sql>
    </changeSet>

    <changeSet id="add-delete-bulk-reschedule-permission" author="codex">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'DELETE_RESCHEDULELOAN'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="loan_reschedule"/>
            <column name="code" value="DELETE_RESCHEDULELOAN"/>
            <column name="entity_name" value="RESCHEDULELOAN"/>
            <column name="action_name" value="DELETE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="grant-delete-bulk-reschedule-to-creators" author="codex">
        <comment>Users who can create bulk reschedules may cancel previews.</comment>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT DISTINCT rp.role_id, delete_permission.id
            FROM m_role_permission rp
            JOIN m_permission create_permission ON create_permission.id = rp.permission_id
                AND create_permission.code = 'CREATE_RESCHEDULELOAN'
            CROSS JOIN m_permission delete_permission
            WHERE delete_permission.code = 'DELETE_RESCHEDULELOAN'
              AND NOT EXISTS (
                SELECT 1 FROM m_role_permission existing
                WHERE existing.role_id = rp.role_id AND existing.permission_id = delete_permission.id
              )
        </sql>
    </changeSet>

    <changeSet id="create-m_bulk_reschedule_result-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_bulk_reschedule_result"/>
            </not>
        </preConditions>
        <createTable tableName="m_bulk_reschedule_result">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="bulk_reschedule_execution_id" type="bigint">
                <constraints nullable="false" foreignKeyName="FK_bulk_reschedule_result_execution_id" references="m_bulk_reschedule_execution(id)"/>
            </column>
            <column name="loan_id" type="bigint">
                <constraints nullable="false" foreignKeyName="FK_bulk_reschedule_result_loan_id" references="m_loan(id)"/>
            </column>
            <column name="status_enum" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="original_interest_rate" type="decimal(19,6)">
                <constraints nullable="true"/>
            </column>
            <column name="new_interest_rate" type="decimal(19,6)">
                <constraints nullable="true"/>
            </column>
            <column name="original_reschedule_request_id" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="reschedule_request_id" type="bigint">
                <constraints nullable="true" foreignKeyName="FK_bulk_reschedule_result_reschedule_request_id" references="m_loan_reschedule_request(id)"/>
            </column>
            <column name="error_message" type="longtext">
                <constraints nullable="true"/>
            </column>
            <column name="exclude_reason" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="loan_account_number" type="varchar(100)"/>
            <column name="client_name" type="varchar(255)"/>
            <column name="account_number" type="varchar(100)"/>
            <column name="office_id_snapshot" type="bigint"/>
            <column name="office_name" type="varchar(255)"/>
            <column name="loan_product_name" type="varchar(255)"/>
            <column name="loan_officer_id_snapshot" type="bigint"/>
            <column name="loan_officer_name" type="varchar(255)"/>
            <column name="loan_status" type="varchar(100)"/>
            <column name="interest_rate_method" type="varchar(100)"/>
            <column name="total_outstanding" type="decimal(19,6)"/>
            <column name="new_total_outstanding" type="decimal(19,6)"/>
            <column name="current_term" type="int"/>
            <column name="new_term" type="int"/>
            <column name="next_scheduled_installment" type="date"/>
            <column name="reschedule_reason" type="varchar(255)"/>
        </createTable>
        <createIndex tableName="m_bulk_reschedule_result" indexName="idx_bulk_reschedule_result_execution_id">
            <column name="bulk_reschedule_execution_id"/>
        </createIndex>
        <createIndex tableName="m_bulk_reschedule_result" indexName="idx_bulk_reschedule_result_loan_id">
            <column name="loan_id"/>
        </createIndex>
        <createIndex tableName="m_bulk_reschedule_result" indexName="idx_bulk_reschedule_result_status">
            <column name="status_enum"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-m_bulk_reschedule_audit-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_bulk_reschedule_audit"/>
            </not>
        </preConditions>
        <createTable tableName="m_bulk_reschedule_audit">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="bulk_reschedule_execution_id" type="bigint">
                <constraints nullable="false" foreignKeyName="FK_bulk_reschedule_audit_execution_id" references="m_bulk_reschedule_execution(id)"/>
            </column>
            <column name="action_enum" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="actor_id" type="bigint">
                <constraints nullable="false" foreignKeyName="FK_bulk_reschedule_audit_actor_id" references="m_appuser(id)"/>
            </column>
            <column name="timestamp" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="details_json" type="longtext">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="m_bulk_reschedule_audit" indexName="idx_bulk_reschedule_audit_execution_id">
            <column name="bulk_reschedule_execution_id"/>
        </createIndex>
        <createIndex tableName="m_bulk_reschedule_audit" indexName="idx_bulk_reschedule_audit_timestamp">
            <column name="timestamp"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
