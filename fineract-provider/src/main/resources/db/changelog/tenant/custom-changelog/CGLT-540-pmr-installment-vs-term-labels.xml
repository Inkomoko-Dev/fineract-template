<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        CGLT-540: Portfolio Management must not present installment count as the repayment term.
        number_of_repayments is the installment count; term_frequency remains Terms Duration.
    -->
    <changeSet id="CGLT-540-pmr-installment-vs-term-labels" author="felixm@inkomoko.com">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM stretchy_report
                WHERE report_name = 'Portfolio Management'
                  AND report_sql LIKE '%as ''Re-payment Term''%'
            </sqlCheck>
        </preConditions>
        <sql>
            UPDATE stretchy_report
            SET report_sql = REPLACE(report_sql, 'as ''Re-payment Term''', 'as ''Number of Installments''')
            WHERE report_name = 'Portfolio Management'
              AND report_sql LIKE '%as ''Re-payment Term''%';
        </sql>
    </changeSet>

</databaseChangeLog>
