    <changeSet id="20261112-678-07-voice-recording-access-log" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="voice_recording_access_log"/>
            </not>
        </preConditions>
        <createTable tableName="voice_recording_access_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="username" type="VARCHAR(100)"/>
            <column name="call_log_id" type="BIGINT"/>
            <column name="recording_url_present" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="accessed_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

