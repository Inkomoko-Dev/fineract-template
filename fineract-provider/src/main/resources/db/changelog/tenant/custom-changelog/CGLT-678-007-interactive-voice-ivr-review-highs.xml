    <changeSet id="20261112-678-07-loan-repayment-instructions" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM voice_ivr_menu_option WHERE menu_key = 'LOAN' AND language_code = 'en' AND option_digit = 5</sqlCheck>
        </preConditions>
        <insert tableName="voice_ivr_menu_option">
            <column name="menu_key" value="LOAN"/>
            <column name="language_code" value="en"/>
            <column name="option_digit" valueNumeric="5"/>
            <column name="option_label" value="Repayment Instructions"/>
            <column name="action_type" value="LOAN_SERVICE"/>
            <column name="action_target" value="REPAYMENT_INSTRUCTIONS"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="voice_ivr_menu_option">
            <column name="menu_key" value="LOAN"/>
            <column name="language_code" value="rw"/>
            <column name="option_digit" valueNumeric="5"/>
            <column name="option_label" value="Amabwiriza yo kwishyura"/>
            <column name="action_type" value="LOAN_SERVICE"/>
            <column name="action_target" value="REPAYMENT_INSTRUCTIONS"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
    </changeSet>

