        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="6"/>
            <column name="option_label" value="Amahirwe yo guhuza isoko"/>
            <column name="action_type" value="CONTENT"/>
            <column name="action_target" value="MARKET_LINKAGE"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="7"/>
            <column name="option_label" value="Vugana n'umujyanama"/>
            <column name="action_type" value="ADVISOR_HANDOFF"/>
            <column name="action_target" value="ADVISOR"/>
