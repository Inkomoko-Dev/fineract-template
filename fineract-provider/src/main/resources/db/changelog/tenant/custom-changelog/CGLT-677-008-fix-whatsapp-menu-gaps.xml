        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="4"/>
            <column name="option_label" value="Imiterere y'inguzanyo"/>
            <column name="action_type" value="LOAN_SERVICE"/>
            <column name="action_target" value="LOAN_STATUS"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="5"/>
            <column name="option_label" value="Amahugurwa y'ubucuruzi"/>
