<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260908-677-28-complete-main-menu-rw" author="Felix Mutua">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT CASE WHEN COUNT(*) &lt; 8 THEN 1 ELSE 0 END FROM whatsapp_menu_option WHERE menu_key = 'MAIN' AND language_code = 'rw'</sqlCheck>
        </preConditions>
        <delete tableName="whatsapp_menu_option">
            <where>menu_key = 'MAIN' AND language_code = 'rw'</where>
        </delete>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="1"/>
            <column name="option_label" value="Amafaranga y'inguzanyo"/>
            <column name="action_type" value="LOAN_SERVICE"/>
            <column name="action_target" value="LOAN_BALANCE"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="2"/>
            <column name="option_label" value="Itariki yo kwishyura ikurikira"/>
            <column name="action_type" value="LOAN_SERVICE"/>
            <column name="action_target" value="NEXT_REPAYMENT"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="whatsapp_menu_option">
            <column name="menu_key" value="MAIN"/>
            <column name="language_code" value="rw"/>
            <column name="option_number" valueNumeric="3"/>
