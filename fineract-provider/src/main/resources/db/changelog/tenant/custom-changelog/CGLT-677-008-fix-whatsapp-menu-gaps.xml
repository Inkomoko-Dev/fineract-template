        <update tableName="whatsapp_menu_definition">
            <column name="header_text" value="Murakaza neza kuri Inkomoko.&#10;Hitamo:"/>
            <where>menu_key = 'MAIN' AND language_code = 'rw'</where>
        </update>
    </changeSet>

    <changeSet id="20260908-677-29-update-loan-submenu-headers" author="Felix Mutua">
        <update tableName="whatsapp_menu_definition">
            <column name="header_text" value="Loan self-service (verification required):"/>
            <where>menu_key = 'LOAN' AND language_code = 'en'</where>
        </update>
        <update tableName="whatsapp_menu_definition">
            <column name="header_text" value="Serivisi y'inguzanyo (kwemeza bisabwa):"/>
            <where>menu_key = 'LOAN' AND language_code = 'rw'</where>
        </update>
    </changeSet>

</databaseChangeLog>
