<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="CGLT-761-idx-m-client-status-office" author="nelsonomoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_client" indexName="idx_m_client_status_office"/>
            </not>
        </preConditions>
        <comment>Speed client list filters by status and office</comment>
        <createIndex tableName="m_client" indexName="idx_m_client_status_office">
            <column name="status_enum"/>
            <column name="office_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="CGLT-761-idx-m-client-display-name" author="nelsonomoi">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_client" indexName="idx_m_client_display_name"/>
            </not>
        </preConditions>
        <comment>Help prefix / equality lookups on display_name (leading-wildcard LIKE still scans)</comment>
        <createIndex tableName="m_client" indexName="idx_m_client_display_name">
            <column name="display_name"/>
        </createIndex>
    </changeSet>

